+#include "PblvDocument.h"
+
+#include <QtCore/QFile>
+
+namespace {
+QString _fail(QString* out, const QString& msg) {
+	if (out) {
+		*out = msg;
+	}
+	return msg;
+}
+
+bool _hasBytes(const QByteArray& data, int offset, int len) {
+	if (offset < 0 || len < 0) {
+		return false;
+	}
+	return offset + len <= data.size();
+}
+} // namespace
+
+PblvDocument::PblvDocument(QObject* parent)
+    : QObject(parent) { }
+
+bool PblvDocument::isLoaded() const {
+	return !m_data.isEmpty() && m_mapW != 0 && m_mapH != 0;
+}
+
+QString PblvDocument::filePath() const {
+	return m_path;
+}
+
+quint16 PblvDocument::mapW() const {
+	return m_mapW;
+}
+
+quint16 PblvDocument::mapH() const {
+	return m_mapH;
+}
+
+quint16 PblvDocument::tileCount() const {
+	return m_tileCount;
+}
+
+quint16 PblvDocument::bankCount() const {
+	return m_bankCount;
+}
+
+quint16 PblvDocument::tileW() const {
+	return 16;
+}
+
+quint16 PblvDocument::tileH() const {
+	return 16;
+}
+
+quint16 PblvDocument::tileBytesPerTile() const {
+	// Pebble-packed 2bpp: 4 pixels per byte.
+	return static_cast<quint16>((tileW() * tileH()) / 4);
+}
+
+bool PblvDocument::isCgb() const {
+	return m_isCgb;
+}
+
+quint8 PblvDocument::lcdc() const {
+	return m_lcdc;
+}
+
+int PblvDocument::spriteHeight() const {
+	return (m_lcdc & 0x04) ? 16 : 8;
+}
+
+quint32 PblvDocument::tileIdFromTileKey(quint16 tileKey) const {
+	const quint32 tileIndex = static_cast<quint32>(tileKey & 0x7FFFu);
+	const quint32 bank = static_cast<quint32>((tileKey >> 15) & 1u);
+	return bank * static_cast<quint32>(m_tileCount) + tileIndex;
+}
+
+bool PblvDocument::tileKeyFromTileId(quint32 tileId, quint16* outTileKey) const {
+	if (!outTileKey) {
+		return false;
+	}
+	*outTileKey = 0;
+	if (m_tileCount == 0 || m_bankCount == 0) {
+		return false;
+	}
+	const quint32 tileCount = static_cast<quint32>(m_tileCount);
+	const quint32 bank = tileId / tileCount;
+	const quint32 tileIndex = tileId % tileCount;
+	if (bank >= static_cast<quint32>(m_bankCount)) {
+		return false;
+	}
+	if (tileIndex >= tileCount) {
+		return false;
+	}
+	const quint16 tileKey = static_cast<quint16>(((bank & 1u) << 15) | (tileIndex & 0x7FFFu));
+	*outTileKey = tileKey;
+	return true;
+}
+
+QVector<quint8> PblvDocument::bgPaletteBytes() const {
+	return m_previewActive ? m_previewBgPaletteBytes : m_bgPaletteBytes;
+}
+
+QVector<quint8> PblvDocument::objPaletteBytes() const {
+	return m_previewActive ? m_previewObjPaletteBytes : m_objPaletteBytes;
+}
+
+int PblvDocument::spriteCount() const {
+	return m_oamBytes.size() / 4;
+}
+
+bool PblvDocument::spriteRaw(int index, quint8* outY, quint8* outX, quint8* outTile, quint8* outAttr) const {
+	if (!isLoaded()) {
+		return false;
+	}
+	if (index < 0 || index >= spriteCount()) {
+		return false;
+	}
+	const int off = index * 4;
+	const QByteArray& oam = m_previewActive ? m_previewOamBytes : m_oamBytes;
+	if (outY) {
+		*outY = static_cast<quint8>(oam[off + 0]);
+	}
+	if (outX) {
+		*outX = static_cast<quint8>(oam[off + 1]);
+	}
+	if (outTile) {
+		*outTile = static_cast<quint8>(oam[off + 2]);
+	}
+	if (outAttr) {
+		*outAttr = static_cast<quint8>(oam[off + 3]);
+	}
+	return true;
+}
+
+bool PblvDocument::setSpriteRaw(int index, quint8 y, quint8 x, quint8 tile, quint8 attr) {
+	if (!isLoaded()) {
+		return false;
+	}
+	if (index < 0 || index >= spriteCount()) {
+		return false;
+	}
+	const int off = index * 4;
+	if (off + 3 >= m_oamBytes.size()) {
+		return false;
+	}
+	const bool changedBase = (static_cast<quint8>(m_oamBytes[off + 0]) != y) ||
+	    (static_cast<quint8>(m_oamBytes[off + 1]) != x) || (static_cast<quint8>(m_oamBytes[off + 2]) != tile) ||
+	    (static_cast<quint8>(m_oamBytes[off + 3]) != attr);
+	bool changedPreview = false;
+	if (m_previewActive && m_previewOamBytes.size() > off + 3) {
+		changedPreview = (static_cast<quint8>(m_previewOamBytes[off + 0]) != y) ||
+		    (static_cast<quint8>(m_previewOamBytes[off + 1]) != x) ||
+		    (static_cast<quint8>(m_previewOamBytes[off + 2]) != tile) ||
+		    (static_cast<quint8>(m_previewOamBytes[off + 3]) != attr);
+	}
+	if (!changedBase && !changedPreview) {
+		return true;
+	}
+	m_oamBytes[off + 0] = static_cast<char>(y);
+	m_oamBytes[off + 1] = static_cast<char>(x);
+	m_oamBytes[off + 2] = static_cast<char>(tile);
+	m_oamBytes[off + 3] = static_cast<char>(attr);
+	if (m_previewActive && m_previewOamBytes.size() > off + 3) {
+		m_previewOamBytes[off + 0] = static_cast<char>(y);
+		m_previewOamBytes[off + 1] = static_cast<char>(x);
+		m_previewOamBytes[off + 2] = static_cast<char>(tile);
+		m_previewOamBytes[off + 3] = static_cast<char>(attr);
+	}
+	if (m_oamOffset > 0 && _hasBytes(m_data, m_oamOffset + off, 4)) {
+		m_data[m_oamOffset + off + 0] = static_cast<char>(y);
+		m_data[m_oamOffset + off + 1] = static_cast<char>(x);
+		m_data[m_oamOffset + off + 2] = static_cast<char>(tile);
+		m_data[m_oamOffset + off + 3] = static_cast<char>(attr);
+	}
+	emit documentChanged();
+	return true;
+}
+
+bool PblvDocument::setBgPaletteEntry(int paletteId, int colorId, quint8 gcolor) {
+	if (!isLoaded()) {
+		return false;
+	}
+	if (paletteId < 0 || paletteId >= 8 || colorId < 0 || colorId >= 4) {
+		return false;
+	}
+	const int idx = paletteId * 4 + colorId;
+	if (idx < 0 || idx >= m_bgPaletteBytes.size()) {
+		return false;
+	}
+	if (!_hasBytes(m_data, m_paletteOffset + idx, 1)) {
+		return false;
+	}
+	if (m_bgPaletteBytes[idx] == gcolor && static_cast<quint8>(m_data[m_paletteOffset + idx]) == gcolor) {
+		return true;
+	}
+	m_bgPaletteBytes[idx] = gcolor;
+	m_data[m_paletteOffset + idx] = static_cast<char>(gcolor);
+	emit documentChanged();
+	return true;
+}
+
+bool PblvDocument::setObjPaletteEntry(int paletteId, int colorId, quint8 gcolor) {
+	if (!isLoaded()) {
+		return false;
+	}
+	if (paletteId < 0 || paletteId >= 8 || colorId < 0 || colorId >= 4) {
+		return false;
+	}
+	const int idx = paletteId * 4 + colorId;
+	if (idx < 0 || idx >= m_objPaletteBytes.size()) {
+		return false;
+	}
+	if (m_objPaletteOffset <= 0 || !_hasBytes(m_data, m_objPaletteOffset + idx, 1)) {
+		return false;
+	}
+	if (m_objPaletteBytes[idx] == gcolor && static_cast<quint8>(m_data[m_objPaletteOffset + idx]) == gcolor) {
+		return true;
+	}
+	m_objPaletteBytes[idx] = gcolor;
+	m_data[m_objPaletteOffset + idx] = static_cast<char>(gcolor);
+	emit documentChanged();
+	return true;
+}
+
+quint16 PblvDocument::mapTileKey(int x, int y) const {
+	if (x < 0 || y < 0 || x >= m_mapW || y >= m_mapH) {
+		return 0;
+	}
+	const int index = x + y * m_mapW;
+	return (m_previewActive ? m_previewMapTileKeys : m_mapTileKeys).value(index);
+}
+
+quint8 PblvDocument::mapPalette(int x, int y) const {
+	if (x < 0 || y < 0 || x >= m_mapW || y >= m_mapH) {
+		return 0;
+	}
+	const int index = x + y * m_mapW;
+	return (m_previewActive ? m_previewMapPalettes : m_mapPalettes).value(index);
+}
+
+void PblvDocument::setMapCell(int x, int y, quint16 tileKey, quint8 palette) {
+	if (x < 0 || y < 0 || x >= m_mapW || y >= m_mapH) {
+		return;
+	}
+	const int index = x + y * m_mapW;
+	if (index < 0 || index >= m_mapTileKeys.size() || index >= m_mapPalettes.size()) {
+		return;
+	}
+	palette &= 7;
+	if (m_mapTileKeys[index] == tileKey && m_mapPalettes[index] == palette) {
+		return;
+	}
+	m_mapTileKeys[index] = tileKey;
+	m_mapPalettes[index] = palette;
+	emit documentChanged();
+}
+
+bool PblvDocument::tilePixels(quint16 bank, quint16 tileIndex, const quint8** outPtr) const {
+	if (!outPtr) {
+		return false;
+	}
+	*outPtr = nullptr;
+	if (!isLoaded()) {
+		return false;
+	}
+	if (bank >= m_bankCount || tileIndex >= m_tileCount) {
+		return false;
+	}
+	const int tileSize = static_cast<int>(tileBytesPerTile());
+	const int tilesPerBankBytes = static_cast<int>(m_tileCount) * tileSize;
+	if (m_previewActive) {
+		const int offset = (bank * tilesPerBankBytes) + (tileIndex * tileSize);
+		if (!_hasBytes(m_previewTileTable, offset, tileSize)) {
+			return false;
+		}
+		*outPtr = reinterpret_cast<const quint8*>(m_previewTileTable.constData() + offset);
+		return true;
+	}
+	const int tileTableSizeBytes = m_bankCount * tilesPerBankBytes;
+	const int offset = m_tileTableOffset + (bank * tilesPerBankBytes) + (tileIndex * tileSize);
+	if (!_hasBytes(m_data, offset, tileSize) || !_hasBytes(m_data, m_tileTableOffset, tileTableSizeBytes)) {
+		return false;
+	}
+	*outPtr = reinterpret_cast<const quint8*>(m_data.constData() + offset);
+	return true;
+}
+
+bool PblvDocument::setTilePixel(quint16 bank, quint16 tileIndex, int x, int y, quint8 value) {
+	if (!isLoaded()) {
+		return false;
+	}
+	if (bank >= m_bankCount || tileIndex >= m_tileCount) {
+		return false;
+	}
+	const int tileW = this->tileW();
+	const int tileH = this->tileH();
+	if (x < 0 || y < 0 || x >= tileW || y >= tileH) {
+		return false;
+	}
+	value &= 3;
+
+	const int bytesPerRow = tileW / 4;
+	const int tileSize = static_cast<int>(tileBytesPerTile());
+	const int tilesPerBankBytes = static_cast<int>(m_tileCount) * tileSize;
+	const int offset =
+	    m_tileTableOffset + (static_cast<int>(bank) * tilesPerBankBytes) + (static_cast<int>(tileIndex) * tileSize);
+	if (!_hasBytes(m_data, offset, tileSize)) {
+		return false;
+	}
+
+	const int byteOff = offset + y * bytesPerRow + (x / 4);
+	if (!_hasBytes(m_data, byteOff, 1)) {
+		return false;
+	}
+
+	const int shift = 6 - 2 * (x & 3);
+	const quint8 mask = static_cast<quint8>(3u << shift);
+	quint8 b = static_cast<quint8>(m_data[byteOff]);
+	const quint8 old = static_cast<quint8>((b >> shift) & 3u);
+	if (old == value) {
+		return true;
+	}
+	b = static_cast<quint8>((b & ~mask) | ((value & 3u) << shift));
+	m_data[byteOff] = static_cast<char>(b);
+	emit documentChanged();
+	return true;
+}
+
+bool PblvDocument::cycleTilePixels(quint16 bank, quint16 tileIndex, const QRect& rect, int delta) {
+	if (!isLoaded()) {
+		return false;
+	}
+	if (bank >= m_bankCount || tileIndex >= m_tileCount) {
+		return false;
+	}
+	if (!rect.isValid()) {
+		return false;
+	}
+	if (delta == 0) {
+		return true;
+	}
+
+	const int tileW = this->tileW();
+	const int tileH = this->tileH();
+	QRect r = rect.normalized();
+	r = r.intersected(QRect(0, 0, tileW, tileH));
+	if (!r.isValid()) {
+		return false;
+	}
+
+	const int bytesPerRow = tileW / 4;
+	const int tileSize = static_cast<int>(tileBytesPerTile());
+	const int tilesPerBankBytes = static_cast<int>(m_tileCount) * tileSize;
+	const int base =
+	    m_tileTableOffset + (static_cast<int>(bank) * tilesPerBankBytes) + (static_cast<int>(tileIndex) * tileSize);
+	if (!_hasBytes(m_data, base, tileSize)) {
+		return false;
+	}
+
+	const int normDelta = ((delta % 4) + 4) % 4;
+	bool anyChanged = false;
+	for (int y = r.top(); y <= r.bottom(); ++y) {
+		for (int x = r.left(); x <= r.right(); ++x) {
+			const int byteOff = base + y * bytesPerRow + (x / 4);
+			const int shift = 6 - 2 * (x & 3);
+			const quint8 mask = static_cast<quint8>(3u << shift);
+			quint8 b = static_cast<quint8>(m_data[byteOff]);
+			const quint8 oldPx = static_cast<quint8>((b >> shift) & 3u);
+			const quint8 newPx = static_cast<quint8>((oldPx + normDelta) & 3u);
+			if (oldPx == newPx) {
+				continue;
+			}
+			b = static_cast<quint8>((b & ~mask) | ((newPx & 3u) << shift));
+			m_data[byteOff] = static_cast<char>(b);
+			anyChanged = true;
+		}
+	}
+	if (anyChanged) {
+		emit documentChanged();
+	}
+	return true;
+}
+
+int PblvDocument::frameCount() const {
+	return m_frames.size();
+}
+
+const PblvDocument::PblvFrameRecord* PblvDocument::frame(int index) const {
+	if (index < 0 || index >= m_frames.size()) {
+		return nullptr;
+	}
+	return &m_frames[index];
+}
+
+bool PblvDocument::removeFrame(int index) {
+	if (index < 0 || index >= m_frames.size()) {
+		return false;
+	}
+	if (index + 1 < m_frames.size()) {
+		const quint32 sum =
+		    static_cast<quint32>(m_frames[index].deltaFrames) + static_cast<quint32>(m_frames[index + 1].deltaFrames);
+		m_frames[index + 1].deltaFrames = static_cast<quint16>(sum > 0xFFFFu ? 0xFFFFu : sum);
+	}
+	m_frames.removeAt(index);
+	m_framesDirty = true;
+	clearPreviewFrame();
+	emit framesChanged();
+	emit documentChanged();
+	return true;
+}
+
+bool PblvDocument::removeMapUpdate(int frameIndex, int updateIndex) {
+	if (frameIndex < 0 || frameIndex >= m_frames.size()) {
+		return false;
+	}
+	auto& frame = m_frames[frameIndex];
+	if (updateIndex < 0 || updateIndex >= frame.mapUpdates.size()) {
+		return false;
+	}
+	frame.mapUpdates.removeAt(updateIndex);
+	m_framesDirty = true;
+	emit framesChanged();
+	emit documentChanged();
+	return true;
+}
+
+bool PblvDocument::removeOamUpdate(int frameIndex, int updateIndex) {
+	if (frameIndex < 0 || frameIndex >= m_frames.size()) {
+		return false;
+	}
+	auto& frame = m_frames[frameIndex];
+	if (updateIndex < 0 || updateIndex >= frame.oamUpdates.size()) {
+		return false;
+	}
+	frame.oamUpdates.removeAt(updateIndex);
+	m_framesDirty = true;
+	emit framesChanged();
+	emit documentChanged();
+	return true;
+}
+
+bool PblvDocument::setPreviewFrame(int frameIndex) {
+	if (frameIndex < 0 || frameIndex >= m_frames.size()) {
+		clearPreviewFrame();
+		return false;
+	}
+	m_previewActive = true;
+	m_previewBgPaletteBytes = m_keyframeBgPaletteBytes.isEmpty() ? m_bgPaletteBytes : m_keyframeBgPaletteBytes;
+	m_previewObjPaletteBytes = m_keyframeObjPaletteBytes.isEmpty() ? m_objPaletteBytes : m_keyframeObjPaletteBytes;
+	m_previewMapTileKeys = m_keyframeMapTileKeys.isEmpty() ? m_mapTileKeys : m_keyframeMapTileKeys;
+	m_previewMapPalettes = m_keyframeMapPalettes.isEmpty() ? m_mapPalettes : m_keyframeMapPalettes;
+	m_previewTileTable = m_keyframeTileTable.isEmpty() ? QByteArray() : m_keyframeTileTable;
+	if (m_previewTileTable.isEmpty() && m_tileTableOffset > 0) {
+		const int tileSize = static_cast<int>(tileBytesPerTile());
+		const int tileTableBytes = static_cast<int>(m_bankCount) * static_cast<int>(m_tileCount) * tileSize;
+		if (_hasBytes(m_data, m_tileTableOffset, tileTableBytes)) {
+			m_previewTileTable = QByteArray(m_data.constData() + m_tileTableOffset, tileTableBytes);
+		}
+	}
+	m_previewOamBytes = m_keyframeOamBytes.isEmpty() ? m_oamBytes : m_keyframeOamBytes;
+
+	for (int i = 0; i <= frameIndex; ++i) {
+		_applyFrameToPreview(m_frames[i]);
+	}
+	emit documentChanged();
+	return true;
+}
+
+void PblvDocument::clearPreviewFrame() {
+	m_previewActive = false;
+	m_previewAnimatedMap.clear();
+	m_previewAnimatedSprites.clear();
+	emit documentChanged();
+}
