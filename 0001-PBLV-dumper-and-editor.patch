diff --git a/doc/pblv.hexpat b/doc/pblv.hexpat
new file mode 100644
index 000000000..9f1d1b871
--- /dev/null
+++ b/doc/pblv.hexpat
@@ -0,0 +1,160 @@
+// PBLV (Pebble Video Log) inspector
+// Mirrors doc/pebble-pblv-format.md
+
+import std.core;
+import std.mem;
+import std.ptr;
+import std.bit;
+import std.io;
+
+using u8le  = le u8;
+using u16le = le u16;
+using u32le = le u32;
+
+bitfield PblvFlags {
+    model_cgb  : 1;
+    vram_2bank : 1;
+    padding    : 30;
+};
+
+struct PblvHeader {
+    char  magic[4];       // "PBLV"
+    u16le version;        // 1
+    u16le headerSize;     // 32
+    u32le keyframeOffset; // usually 32
+    u32le framesOffset;   // 0 if no frames emitted
+    u32le nFrames;
+    u16le mapW;           // 20
+    u16le mapH;           // 18
+    PblvFlags flags;
+    u32le reserved;
+};
+
+struct PblvKeyframeMarker {
+    char  tag[4];  // "KEYF"
+    u32le length;  // currently 0
+};
+
+struct PblvKeyframeParams {
+    u8le model;          // 1=CGB, 0=DMG
+    u8le lcdc;
+    u8le scx;
+    u8le scy;
+    u8le bgMapSelect;    // LCDC bit3
+    u8le tileDataSelect; // LCDC bit4
+    u8le reserved0;
+    u8le reserved1;
+};
+
+struct PblvMapCell {
+    u16le tileKey;   // bits0..14 tileIndex, bit15 bank
+    u8le  palette;   // 0..7
+    u8le  reserved;
+};
+
+bitfield PblvOamAttr {
+    cgbPalette : 3; // CGB: 0..7
+    cgbBank    : 1; // CGB: VRAM bank
+    dmgPalette : 1; // DMG: 0/1
+    xFlip      : 1;
+    yFlip      : 1;
+    priority   : 1; // OBJ behind BG
+};
+
+struct PblvOamEntry {
+    u8le y;      // Y position + 16
+    u8le x;      // X position + 8
+    u8le tile;   // tile index (8x8); for 8x16 use tile & 0xFE
+    PblvOamAttr attr;
+} [[format("oam_entry_format")]];
+
+fn oam_entry_format(PblvOamEntry entry) {
+    s32 x = entry.x - 8;
+    s32 y = entry.y - 16;
+    return std::format("x={} y={}", x, y);
+};
+
+struct PblvTile {
+    u8le pixels[64];
+};
+
+struct PblvTileBank<auto TileCount> {
+    PblvTile tiles[TileCount];
+};
+
+struct PblvKeyframe {
+    PblvKeyframeMarker marker;
+
+    PblvKeyframeParams params;
+
+    u16le tileCount;     // 384
+    u16le bankCount;     // 2 for CGB, else 1
+    u16le mapW;          // 20
+    u16le mapH;          // 18
+    u16le reserved0;
+    u16le reserved1;
+
+    u16le nPaletteBytes; // 32
+    u8le  paletteBytes[nPaletteBytes];
+
+    // Tile bitmap table: bankCount * tileCount tiles, 64 bytes each (16x16)
+    PblvTileBank<tileCount> banks[bankCount];
+
+    // Visible BG map: mapW*mapH cells
+    PblvMapCell map[mapW * mapH];
+
+    // OBJ palettes (GColor8)
+    u16le nObjPaletteBytes; // 32
+    u8le  objPaletteBytes[nObjPaletteBytes];
+
+    // OAM (sprites): 40 * 4 bytes
+    u16le oamBytes; // 160
+    PblvOamEntry oamData[oamBytes / 4];
+};
+
+struct PblvPalUpdate {
+    u8le palette;
+    u8le color;
+    u8le gcolor;    // Pebble GColor8
+    u8le reserved;
+};
+
+struct PblvTileUpdate {
+    u16le tileKey;
+    u16le reserved;
+    u8le  data[64];
+};
+
+struct PblvMapUpdate {
+    u16le mapIndex; // x + y*20
+    u16le tileKey;
+    u8le  palette;
+    u8le  reserved;
+};
+
+struct PblvOamUpdate {
+    u16le index;   // sprite index 0..39
+    u16le reserved;
+    PblvOamEntry data;
+};
+
+struct PblvFrame {
+    u16le deltaFrames;
+    u16le nPalUpdates;
+    u16le nTileUpdates;
+    u16le nMapUpdates;
+    u16le nObjPalUpdates;
+    u16le nOamUpdates;
+
+    PblvPalUpdate palUpdates[nPalUpdates];
+    PblvTileUpdate tileUpdates[nTileUpdates];
+    PblvMapUpdate mapUpdates[nMapUpdates];
+    PblvPalUpdate objPalUpdates[nObjPalUpdates];
+    PblvOamUpdate oamUpdates[nOamUpdates];
+};
+
+PblvHeader header @ 0x00;
+
+// Keyframe always comes first; offset is kept in header for robustness.
+PblvKeyframe keyframe @ header.keyframeOffset;
+PblvFrame frames[while(!std::mem::eof())] @ header.framesOffset;
diff --git a/doc/pebble-pblv-format.md b/doc/pebble-pblv-format.md
new file mode 100644
index 000000000..8fca72a78
--- /dev/null
+++ b/doc/pebble-pblv-format.md
@@ -0,0 +1,246 @@
+# PBLV (Pebble Video Log) binary format
+
+This repo contains a **local-only** modification that replaces mGBA’s legacy `mVL` video-log output with a Pebble-friendly format called **PBLV**.
+
+Goal: export Game Boy / Game Boy Color background animations that can be consumed by a simple state machine in a Pebble watchface.
+
+- Intended consumer: a Pebble app that maintains:
+  - a tile bitmap table (16x16 tiles, 2bpp)
+  - a per-tile palette selection
+  - a 20x18 “visible background map” grid
+- Sprites (OBJ) are included.
+
+All integer fields are **little-endian**.
+
+## Concepts
+
+### Tile pixels (Pebble `GBitmapFormat2BitPalette`)
+
+PBLV stores tiles as Pebble-packed 2bpp pixels.
+
+- Each tile is **16x16** pixels and stored as **64 bytes**: 4 bytes per row, 16 rows.
+- Exporter behavior: tiles are pixel-doubled at dump time (each original 8x8 pixel becomes a 2x2 block).
+
+- Pixels are stored left-to-right.
+- For each row, 8 pixels are packed into 2 bytes.
+- Each byte holds 4 pixels:
+
+```
+byte = (p0 << 6) | (p1 << 4) | (p2 << 2) | p3
+```
+
+where each `pN` is a 2-bit palette index (0..3).
+
+### Colors (`GColor8`)
+Palette colors are stored as Pebble `GColor8` bytes (`0bAARRGGBB`, 2 bits per channel).
+
+- Alpha is always written as `3` (opaque).
+- Conversion used by the exporter is:
+  - interpret GB CGB palette entries as **BGR555** (`0bbbbbgggggrrrrr`)
+  - convert 5-bit channels to 2-bit by rounding
+
+## File layout
+
+### Header (fixed 32 bytes)
+
+| Offset | Size | Name | Description |
+|---:|---:|---|---|
+| 0x00 | 4 | magic | ASCII `PBLV` |
+| 0x04 | 2 | version | `1` |
+| 0x06 | 2 | headerSize | `32` |
+| 0x08 | 4 | keyframeOffset | Offset of keyframe (currently always `32`) |
+| 0x0C | 4 | framesOffset | Offset of first frame record (0 if no frames emitted) |
+| 0x10 | 4 | nFrames | Number of emitted frames |
+| 0x14 | 2 | mapW | Visible map width in tiles (currently `20`) |
+| 0x16 | 2 | mapH | Visible map height in tiles (currently `18`) |
+| 0x18 | 4 | flags | See below |
+| 0x1C | 4 | reserved | 0 |
+
+**flags** bits:
+- bit 0: `MODEL_CGB` (1 if GBC)
+- bit 1: `VRAM_2BANK` (1 if GBC)
+
+### Keyframe
+The keyframe is written immediately after the header.
+
+#### Keyframe marker
+
+| Field | Size | Value |
+|---|---:|---|
+| tag | 4 | ASCII `KEYF` |
+| length | 4 | reserved, currently `0` |
+
+#### Keyframe parameters
+8 bytes:
+
+| Byte | Name | Description |
+|---:|---|---|
+| 0 | model | `1` for CGB, `0` otherwise |
+| 1 | lcdc | Raw LCDC register at capture start |
+| 2 | scx | Raw SCX register at capture start |
+| 3 | scy | Raw SCY register at capture start |
+| 4 | bgMapSelect | `1` if LCDC bit3 selects $9C00, else `0` ($9800) |
+| 5 | tileDataSelect | `1` if LCDC bit4 selects $8000 unsigned tiles, else `0` ($8800 signed) |
+| 6..7 | reserved | 0 |
+
+Then:
+
+| Field | Size | Description |
+|---|---:|---|
+| tileCount | 2 | currently `384` |
+| bankCount | 2 | `2` for CGB, else `1` |
+| mapW | 2 | currently `20` |
+| mapH | 2 | currently `18` |
+| reserved0 | 2 | 0 |
+| reserved1 | 2 | 0 |
+
+#### BG palettes
+
+| Field | Size | Description |
+|---|---:|---|
+| nPaletteBytes | 2 | currently `32` |
+| paletteBytes | 32 | `GColor8` bytes for BG palettes (8 palettes × 4 colors) |
+
+Palette entry index is:
+
+```
+index = paletteId * 4 + colorId
+paletteId in 0..7
+colorId in 0..3
+```
+
+#### Tile bitmap table
+Immediately after palettes:
+
+- `bankCount` banks
+- each bank contains `tileCount` tiles
+- each tile is 64 bytes of Pebble-packed 2bpp pixels (16x16)
+
+Layout:
+
+```
+for bank in 0..bankCount-1:
+  for tileIndex in 0..tileCount-1:
+    uint8 tilePixels[64]
+```
+
+#### Visible BG map (20x18)
+Finally, the visible map grid (row-major):
+
+For each cell, 4 bytes:
+
+| Field | Size | Description |
+|---|---:|---|
+| tileKey | 2 | tile index + bank bit |
+| palette | 1 | palette index 0..7 |
+| reserved | 1 | 0 |
+
+`tileKey`:
+- bits 0..14: tileIndex (0..383)
+- bit 15: VRAM bank (0 = bank0, 1 = bank1)
+
+#### OBJ palettes
+Immediately after the visible BG map:
+
+| Field | Size | Description |
+|---|---:|---|
+| nObjPaletteBytes | 2 | currently `32` |
+| paletteBytes | 32 | `GColor8` bytes for OBJ palettes (8 palettes × 4 colors) |
+
+Palette entry index is:
+
+```
+index = paletteId * 4 + colorId
+paletteId in 0..7
+colorId in 0..3
+```
+
+#### OAM (sprites)
+Immediately after OBJ palettes:
+
+| Field | Size | Description |
+|---|---:|---|
+| oamBytes | 2 | currently `160` |
+| oamData | 160 | raw GB OAM bytes (40 sprites × 4 bytes) |
+
+Each sprite entry is 4 bytes in standard GB order:
+
+| Byte | Name | Description |
+|---:|---|---|
+| 0 | y | Y position + 16 |
+| 1 | x | X position + 8 |
+| 2 | tile | tile index (8x8); for 8x16 use `tile & 0xFE` |
+| 3 | attr | palette/bank/flip/priority attributes |
+
+## Frames
+Frames are written sequentially, starting at `framesOffset`.
+
+A frame represents a set of updates that become visible after `deltaFrames` video frames.
+
+### Frame header (12 bytes)
+
+| Field | Size | Description |
+|---|---:|---|
+| deltaFrames | 2 | number of GB frames since previous emitted frame |
+| nPalUpdates | 2 | number of palette updates |
+| nTileUpdates | 2 | number of tile updates |
+| nMapUpdates | 2 | number of visible-map updates |
+| nObjPalUpdates | 2 | number of OBJ palette updates |
+| nOamUpdates | 2 | number of OAM (sprite) updates |
+
+### Palette updates
+`nPalUpdates` records, 4 bytes each:
+
+| Field | Size | Description |
+|---|---:|---|
+| palette | 1 | paletteId (0..7) |
+| color | 1 | colorId (0..3) |
+| gcolor | 1 | `GColor8` |
+| reserved | 1 | 0 |
+
+### Tile updates
+`nTileUpdates` records:
+
+- 68 bytes each
+
+| Field | Size | Description |
+|---|---:|---|
+| tileKey | 2 | tile index + bank bit (same encoding as keyframe) |
+| reserved | 2 | 0 |
+| data | 64 | Pebble-packed 2bpp tile pixels (16x16) |
+
+### Map updates
+`nMapUpdates` records, 6 bytes each:
+
+| Field | Size | Description |
+|---|---:|---|
+| mapIndex | 2 | index into 20x18 map, `x + y*20` |
+| tileKey | 2 | new tileKey |
+| palette | 1 | new palette index |
+| reserved | 1 | 0 |
+
+### OBJ palette updates
+`nObjPalUpdates` records, 4 bytes each (same layout as BG palette updates):
+
+| Field | Size | Description |
+|---|---:|---|
+| palette | 1 | paletteId (0..7) |
+| color | 1 | colorId (0..3) |
+| gcolor | 1 | `GColor8` |
+| reserved | 1 | 0 |
+
+### OAM updates
+`nOamUpdates` records, 8 bytes each:
+
+| Field | Size | Description |
+|---|---:|---|
+| index | 2 | sprite index (0..39) |
+| reserved | 2 | 0 |
+| data | 4 | raw OAM bytes for that sprite |
+
+## Notes / limitations (current exporter)
+
+- Only BG (visible 20x18) is exported for the background; sprites are exported separately.
+- View is assumed static: SCX/SCY/LCDC changes after start are ignored.
+- Only BG palettes are exported; OBJ palettes are ignored.
+- Frames are only emitted when there were updates; otherwise time is accumulated into `deltaFrames`.
