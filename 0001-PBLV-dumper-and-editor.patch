diff --git a/src/platform/qt/pblv/PblvTileMapWidget.cpp b/src/platform/qt/pblv/PblvTileMapWidget.cpp
new file mode 100644
index 000000000..5d1240b88
--- /dev/null
+++ b/src/platform/qt/pblv/PblvTileMapWidget.cpp
@@ -0,0 +1,349 @@
+#include "PblvTileMapWidget.h"
+
+#include "PblvDocument.h"
+
+#include <QtGui/QPainter>
+#include <QtMath>
+
+PblvTileMapWidget::PblvTileMapWidget(QWidget* parent)
+    : QWidget(parent) {
+	setMinimumSize(QSize(160, 144));
+	setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Expanding);
+}
+
+void PblvTileMapWidget::setDocument(PblvDocument* doc) {
+	if (m_doc == doc) {
+		return;
+	}
+	if (m_doc) {
+		disconnect(m_doc, nullptr, this, nullptr);
+	}
+	m_doc = doc;
+	if (m_doc) {
+		connect(m_doc, &PblvDocument::documentChanged, this, &PblvTileMapWidget::_rebuildImage);
+		connect(m_doc, &PblvDocument::documentLoaded, this, &PblvTileMapWidget::_rebuildImage);
+	}
+	_rebuildImage();
+}
+
+void PblvTileMapWidget::setSelectedCells(const QVector<QPoint>& cells) {
+	m_selectedCells = cells;
+	update();
+}
+
+void PblvTileMapWidget::setSelectedSprites(const QVector<int>& indices) {
+	m_selectedSprites = indices;
+	update();
+}
+
+void PblvTileMapWidget::setAnimatedMapCells(const QVector<int>& mapIndices) {
+	m_animatedMap = mapIndices;
+	update();
+}
+
+void PblvTileMapWidget::setAnimatedSprites(const QVector<int>& spriteIndices) {
+	m_animatedSprites = spriteIndices;
+	update();
+}
+
+QSize PblvTileMapWidget::sizeHint() const {
+	if (!m_doc || !m_doc->isLoaded()) {
+		return QSize(160, 144);
+	}
+	return QSize(m_doc->mapW() * m_doc->tileW(), m_doc->mapH() * m_doc->tileH());
+}
+
+QRgb PblvTileMapWidget::_colorFromGColor8(quint8 g) {
+	const int a2 = (g >> 6) & 3;
+	const int r2 = (g >> 4) & 3;
+	const int g2 = (g >> 2) & 3;
+	const int b2 = (g >> 0) & 3;
+	const int a = a2 * 85;
+	const int r = r2 * 85;
+	const int gg = g2 * 85;
+	const int b = b2 * 85;
+	return qRgba(r, gg, b, a);
+}
+
+void PblvTileMapWidget::_rebuildImage() {
+	if (!m_doc || !m_doc->isLoaded()) {
+		m_image = QImage();
+		m_spriteImage = QImage();
+		update();
+		return;
+	}
+
+	const int tileW = m_doc->tileW();
+	const int tileH = m_doc->tileH();
+	const int bytesPerRow = tileW / 4;
+	const int w = m_doc->mapW() * tileW;
+	const int h = m_doc->mapH() * tileH;
+	QImage img(w, h, QImage::Format_ARGB32);
+	img.fill(qRgba(0, 0, 0, 255));
+
+	const QVector<quint8> pal = m_doc->bgPaletteBytes();
+	const auto colorAt = [&](quint8 paletteId, quint8 colorId) -> QRgb {
+		const int idx = (paletteId & 7) * 4 + (colorId & 3);
+		if (idx < 0 || idx >= pal.size()) {
+			return qRgba(0, 0, 0, 255);
+		}
+		return _colorFromGColor8(pal[idx]);
+	};
+
+	for (int my = 0; my < m_doc->mapH(); ++my) {
+		for (int mx = 0; mx < m_doc->mapW(); ++mx) {
+			const quint16 tileKey = m_doc->mapTileKey(mx, my);
+			const quint8 paletteId = m_doc->mapPalette(mx, my);
+			const quint16 bank = (tileKey >> 15) & 1;
+			const quint16 tileIndex = tileKey & 0x7FFF;
+
+			const quint8* tile = nullptr;
+			if (!m_doc->tilePixels(bank, tileIndex, &tile)) {
+				continue;
+			}
+
+			for (int ty = 0; ty < tileH; ++ty) {
+				const int dstY = my * tileH + ty;
+				QRgb* scan = reinterpret_cast<QRgb*>(img.scanLine(dstY));
+				const int dstX0 = mx * tileW;
+				for (int tx = 0; tx < tileW; ++tx) {
+					const quint8 b = tile[ty * bytesPerRow + (tx / 4)];
+					const int shift = 6 - 2 * (tx & 3);
+					const quint8 px = static_cast<quint8>((b >> shift) & 3);
+					scan[dstX0 + tx] = colorAt(paletteId, px);
+				}
+			}
+		}
+	}
+
+	// Sprite overlay
+	m_spriteImage = QImage(w, h, QImage::Format_ARGB32);
+	m_spriteImage.fill(qRgba(0, 0, 0, 0));
+	const QVector<quint8> objPal = m_doc->objPaletteBytes();
+	const auto objColorAt = [&](quint8 paletteId, quint8 colorId) -> QRgb {
+		if (colorId == 0) {
+			return qRgba(0, 0, 0, 0);
+		}
+		const int idx = (paletteId & 7) * 4 + (colorId & 3);
+		if (idx < 0 || idx >= objPal.size()) {
+			return qRgba(0, 0, 0, 0);
+		}
+		return _colorFromGColor8(objPal[idx]);
+	};
+	const int scale = tileW / 8;
+	const int spriteW = 8 * scale;
+	const int spriteHeight = m_doc->spriteHeight();
+	const int spriteH = spriteHeight * scale;
+	for (int i = 0; i < m_doc->spriteCount(); ++i) {
+		quint8 oy = 0;
+		quint8 ox = 0;
+		quint8 tile = 0;
+		quint8 attr = 0;
+		if (!m_doc->spriteRaw(i, &oy, &ox, &tile, &attr)) {
+			continue;
+		}
+		const int x0 = (static_cast<int>(ox) - 8) * scale;
+		const int y0 = (static_cast<int>(oy) - 16) * scale;
+		if (x0 >= w || y0 >= h || x0 + spriteW <= 0 || y0 + spriteH <= 0) {
+			continue;
+		}
+		const bool xflip = (attr & 0x20) != 0;
+		const bool yflip = (attr & 0x40) != 0;
+		const int bank = (m_doc->isCgb() && (attr & 0x08)) ? 1 : 0;
+		const int paletteId = m_doc->isCgb() ? (attr & 0x07) : ((attr & 0x10) ? 1 : 0);
+		int tileIndex = tile;
+		if (spriteHeight == 16) {
+			tileIndex &= 0xFE;
+		}
+		const quint8* tile0 = nullptr;
+		const quint8* tile1 = nullptr;
+		if (!m_doc->tilePixels(static_cast<quint16>(bank), static_cast<quint16>(tileIndex), &tile0)) {
+			continue;
+		}
+		if (spriteHeight == 16) {
+			(void) m_doc->tilePixels(static_cast<quint16>(bank), static_cast<quint16>(tileIndex + 1), &tile1);
+		}
+
+		for (int sy = 0; sy < spriteH; ++sy) {
+			const int srcY = yflip ? (spriteH - 1 - sy) : sy;
+			const int tileRow = srcY / tileH;
+			const int ty = srcY % tileH;
+			const quint8* tilePtr = (tileRow == 0) ? tile0 : tile1;
+			if (!tilePtr) {
+				continue;
+			}
+			const int dstY = y0 + sy;
+			if (dstY < 0 || dstY >= h) {
+				continue;
+			}
+			QRgb* scan = reinterpret_cast<QRgb*>(m_spriteImage.scanLine(dstY));
+			for (int sx = 0; sx < spriteW; ++sx) {
+				const int srcX = xflip ? (spriteW - 1 - sx) : sx;
+				const int tx = srcX % tileW;
+				const int byteOff = ty * bytesPerRow + (tx / 4);
+				const int shift = 6 - 2 * (tx & 3);
+				const quint8 b = tilePtr[byteOff];
+				const quint8 px = static_cast<quint8>((b >> shift) & 3);
+				if (px == 0) {
+					continue;
+				}
+				const int dstX = x0 + sx;
+				if (dstX < 0 || dstX >= w) {
+					continue;
+				}
+				scan[dstX] = objColorAt(static_cast<quint8>(paletteId), px);
+			}
+		}
+	}
+
+	m_image = img;
+	update();
+}
+
+void PblvTileMapWidget::paintEvent(QPaintEvent* event) {
+	Q_UNUSED(event);
+
+	QPainter p(this);
+	p.fillRect(rect(), palette().window());
+	p.setRenderHint(QPainter::SmoothPixmapTransform, false);
+
+	if (m_image.isNull()) {
+		return;
+	}
+
+	const QSize target = size();
+	const QSize src = m_image.size();
+	if (src.isEmpty()) {
+		return;
+	}
+
+	const qreal sx = static_cast<qreal>(target.width()) / static_cast<qreal>(src.width());
+	const qreal sy = static_cast<qreal>(target.height()) / static_cast<qreal>(src.height());
+	const qreal s = qMax<qreal>(1.0, qFloor(qMin(sx, sy)));
+	const QSize scaled(static_cast<int>(src.width() * s), static_cast<int>(src.height() * s));
+	const QRect dst(QPoint((target.width() - scaled.width()) / 2, (target.height() - scaled.height()) / 2), scaled);
+
+	p.drawImage(dst, m_image);
+	if (!m_spriteImage.isNull()) {
+		p.drawImage(dst, m_spriteImage);
+	}
+
+	if (!m_selectedSprites.isEmpty() && m_doc && m_doc->isLoaded()) {
+		QPen pen(Qt::red);
+		pen.setCosmetic(true);
+		pen.setWidth(2);
+		p.setPen(pen);
+		p.setBrush(Qt::NoBrush);
+
+		const int tileW = m_doc->tileW();
+		const int scale = tileW / 8;
+		const int spriteW = 8 * scale;
+		const int spriteH = m_doc->spriteHeight() * scale;
+		const int screenW = m_doc->mapW() * tileW;
+		const int screenH = m_doc->mapH() * m_doc->tileH();
+
+		for (int idx : m_selectedSprites) {
+			quint8 oy = 0;
+			quint8 ox = 0;
+			quint8 tile = 0;
+			quint8 attr = 0;
+			if (!m_doc->spriteRaw(idx, &oy, &ox, &tile, &attr)) {
+				continue;
+			}
+			const int x0 = (static_cast<int>(ox) - 8) * scale;
+			const int y0 = (static_cast<int>(oy) - 16) * scale;
+			if (x0 >= screenW || y0 >= screenH || x0 + spriteW <= 0 || y0 + spriteH <= 0) {
+				continue;
+			}
+			const int vx = dst.x() + static_cast<int>(x0 * s);
+			const int vy = dst.y() + static_cast<int>(y0 * s);
+			const int vw = static_cast<int>(spriteW * s);
+			const int vh = static_cast<int>(spriteH * s);
+			p.drawRect(QRect(vx, vy, vw, vh).adjusted(0, 0, -1, -1));
+		}
+	}
+
+	if (!m_animatedMap.isEmpty() && m_doc && m_doc->isLoaded()) {
+		QPen pen(Qt::red);
+		pen.setCosmetic(true);
+		pen.setWidth(2);
+		p.setPen(pen);
+		p.setBrush(Qt::NoBrush);
+		const int tileW = m_doc->tileW();
+		const int tileH = m_doc->tileH();
+		for (int idx : m_animatedMap) {
+			if (idx < 0) {
+				continue;
+			}
+			const int mx = idx % m_doc->mapW();
+			const int my = idx / m_doc->mapW();
+			if (mx < 0 || my < 0 || mx >= m_doc->mapW() || my >= m_doc->mapH()) {
+				continue;
+			}
+			const int x = dst.x() + static_cast<int>(mx * tileW * s);
+			const int y = dst.y() + static_cast<int>(my * tileH * s);
+			const int w = static_cast<int>(tileW * s);
+			const int h = static_cast<int>(tileH * s);
+			p.drawRect(QRect(x, y, w, h).adjusted(0, 0, -1, -1));
+		}
+	}
+
+	if (!m_animatedSprites.isEmpty() && m_doc && m_doc->isLoaded()) {
+		QPen pen(Qt::red);
+		pen.setCosmetic(true);
+		pen.setWidth(2);
+		p.setPen(pen);
+		p.setBrush(Qt::NoBrush);
+
+		const int tileW = m_doc->tileW();
+		const int scale = tileW / 8;
+		const int spriteW = 8 * scale;
+		const int spriteH = m_doc->spriteHeight() * scale;
+		const int screenW = m_doc->mapW() * tileW;
+		const int screenH = m_doc->mapH() * m_doc->tileH();
+
+		for (int idx : m_animatedSprites) {
+			quint8 oy = 0;
+			quint8 ox = 0;
+			quint8 tile = 0;
+			quint8 attr = 0;
+			if (!m_doc->spriteRaw(idx, &oy, &ox, &tile, &attr)) {
+				continue;
+			}
+			const int x0 = (static_cast<int>(ox) - 8) * scale;
+			const int y0 = (static_cast<int>(oy) - 16) * scale;
+			if (x0 >= screenW || y0 >= screenH || x0 + spriteW <= 0 || y0 + spriteH <= 0) {
+				continue;
+			}
+			const int vx = dst.x() + static_cast<int>(x0 * s);
+			const int vy = dst.y() + static_cast<int>(y0 * s);
+			const int vw = static_cast<int>(spriteW * s);
+			const int vh = static_cast<int>(spriteH * s);
+			p.drawRect(QRect(vx, vy, vw, vh).adjusted(0, 0, -1, -1));
+		}
+	}
+
+	if (!m_selectedCells.isEmpty()) {
+		p.setBrush(Qt::NoBrush);
+		QPen pen(Qt::red);
+		pen.setCosmetic(true);
+		p.setPen(pen);
+		for (const QPoint& cell : m_selectedCells) {
+			const int mx = cell.x();
+			const int my = cell.y();
+			if (!m_doc || !m_doc->isLoaded()) {
+				continue;
+			}
+			if (mx < 0 || my < 0 || mx >= m_doc->mapW() || my >= m_doc->mapH()) {
+				continue;
+			}
+			const int tileW = m_doc->tileW();
+			const int tileH = m_doc->tileH();
+			const int x = dst.x() + static_cast<int>(mx * tileW * s);
+			const int y = dst.y() + static_cast<int>(my * tileH * s);
+			const int w = static_cast<int>(tileW * s);
+			const int h = static_cast<int>(tileH * s);
+			p.drawRect(QRect(x, y, w, h).adjusted(0, 0, -1, -1));
+		}
+	}
+}
diff --git a/src/platform/qt/pblv/PblvTileMapWidget.h b/src/platform/qt/pblv/PblvTileMapWidget.h
new file mode 100644
index 000000000..687333c1a
--- /dev/null
+++ b/src/platform/qt/pblv/PblvTileMapWidget.h
@@ -0,0 +1,36 @@
+#pragma once
+
+#include <QtWidgets/QWidget>
+
+class PblvDocument;
+
+class PblvTileMapWidget : public QWidget {
+	Q_OBJECT
+
+public:
+	explicit PblvTileMapWidget(QWidget* parent = nullptr);
+
+	void setDocument(PblvDocument* doc);
+	void setSelectedCells(const QVector<QPoint>& cells);
+	void setSelectedSprites(const QVector<int>& indices);
+	void setAnimatedMapCells(const QVector<int>& mapIndices);
+	void setAnimatedSprites(const QVector<int>& spriteIndices);
+
+protected:
+	void paintEvent(QPaintEvent* event) override;
+	QSize sizeHint() const override;
+
+private slots:
+	void _rebuildImage();
+
+private:
+	static QRgb _colorFromGColor8(quint8 g);
+
+	PblvDocument* m_doc = nullptr;
+	QImage m_image;
+	QImage m_spriteImage;
+	QVector<QPoint> m_selectedCells;
+	QVector<int> m_selectedSprites;
+	QVector<int> m_animatedMap;
+	QVector<int> m_animatedSprites;
+};
diff --git a/src/platform/qt/pblv/PblvTilesModel.cpp b/src/platform/qt/pblv/PblvTilesModel.cpp
new file mode 100644
index 000000000..8feb972bf
--- /dev/null
+++ b/src/platform/qt/pblv/PblvTilesModel.cpp
@@ -0,0 +1,162 @@
+#include "PblvTilesModel.h"
+
+#include "PblvDocument.h"
+
+#include <QtGui/QColor>
+#include <QtGui/QImage>
+#include <QtGui/QPixmap>
+
+namespace {
+QRgb _colorFromGColor8(quint8 g) {
+	const int a2 = (g >> 6) & 3;
+	const int r2 = (g >> 4) & 3;
+	const int g2 = (g >> 2) & 3;
+	const int b2 = (g >> 0) & 3;
+	return qRgba(r2 * 85, g2 * 85, b2 * 85, a2 * 85);
+}
+} // namespace
+
+PblvTilesModel::PblvTilesModel(QObject* parent)
+    : QAbstractTableModel(parent) { }
+
+void PblvTilesModel::setDocument(PblvDocument* doc) {
+	if (m_doc == doc) {
+		return;
+	}
+	beginResetModel();
+	if (m_doc) {
+		disconnect(m_doc, nullptr, this, nullptr);
+	}
+	m_doc = doc;
+	if (m_doc) {
+		connect(m_doc, &PblvDocument::documentChanged, this, &PblvTilesModel::_onDocChanged);
+		connect(m_doc, &PblvDocument::documentLoaded, this, &PblvTilesModel::_onDocLoaded);
+	}
+	endResetModel();
+}
+
+PblvDocument* PblvTilesModel::document() const {
+	return m_doc;
+}
+
+int PblvTilesModel::tilesPerRow() const {
+	return m_tilesPerRow;
+}
+
+int PblvTilesModel::columnCount(const QModelIndex& parent) const {
+	if (parent.isValid() || !m_doc || !m_doc->isLoaded()) {
+		return 0;
+	}
+	return m_tilesPerRow;
+}
+
+int PblvTilesModel::rowCount(const QModelIndex& parent) const {
+	if (parent.isValid() || !m_doc || !m_doc->isLoaded()) {
+		return 0;
+	}
+	const int rowsPerBank = (m_doc->tileCount() + m_tilesPerRow - 1) / m_tilesPerRow;
+	return rowsPerBank * m_doc->bankCount();
+}
+
+QImage PblvTilesModel::_tileToImage(const quint8* tilePixels, int tileW, int tileH,
+                                    const QVector<quint8>& bgPaletteBytes, quint8 paletteId) {
+	// Pebble-packed 2bpp: 4 pixels per byte.
+	const int bytesPerRow = tileW / 4;
+	QImage img(tileW, tileH, QImage::Format_ARGB32);
+	img.fill(qRgba(0, 0, 0, 255));
+
+	auto colorAt = [&](quint8 colorId) -> QRgb {
+		const int idx = (paletteId & 7) * 4 + (colorId & 3);
+		if (idx < 0 || idx >= bgPaletteBytes.size()) {
+			return qRgba(0, 0, 0, 255);
+		}
+		return _colorFromGColor8(bgPaletteBytes[idx]);
+	};
+
+	for (int y = 0; y < tileH; ++y) {
+		QRgb* scan = reinterpret_cast<QRgb*>(img.scanLine(y));
+		for (int x = 0; x < tileW; ++x) {
+			const quint8 b = tilePixels[y * bytesPerRow + (x / 4)];
+			const int shift = 6 - 2 * (x & 3);
+			const quint8 px = static_cast<quint8>((b >> shift) & 3);
+			scan[x] = colorAt(px);
+		}
+	}
+
+	return img;
+}
+
+QVariant PblvTilesModel::data(const QModelIndex& index, int role) const {
+	if (!m_doc || !m_doc->isLoaded() || !index.isValid()) {
+		return {};
+	}
+
+	const int col = index.column();
+	const int row = index.row();
+	const int rowsPerBank = (m_doc->tileCount() + m_tilesPerRow - 1) / m_tilesPerRow;
+	const int bank = row / rowsPerBank;
+	const int rowInBank = row % rowsPerBank;
+	const int tileIndex = rowInBank * m_tilesPerRow + col;
+	if (bank < 0 || bank >= m_doc->bankCount()) {
+		return {};
+	}
+	if (tileIndex < 0 || tileIndex >= m_doc->tileCount()) {
+		return {};
+	}
+
+	if (role == Qt::DecorationRole) {
+		const quint8* tile = nullptr;
+		if (!m_doc->tilePixels(static_cast<quint16>(bank), static_cast<quint16>(tileIndex), &tile)) {
+			return {};
+		}
+		const QVector<quint8> pal = m_doc->bgPaletteBytes();
+		QImage img = _tileToImage(tile, m_doc->tileW(), m_doc->tileH(), pal, 0);
+		if (m_tileScale != 1) {
+			img = img.scaled(img.width() * m_tileScale, img.height() * m_tileScale, Qt::IgnoreAspectRatio,
+			                 Qt::FastTransformation);
+		}
+		return QPixmap::fromImage(img);
+	}
+
+	if (role == Qt::ToolTipRole) {
+		const quint32 tileId =
+		    static_cast<quint32>(bank) * static_cast<quint32>(m_doc->tileCount()) + static_cast<quint32>(tileIndex);
+		return QString("tileId=%1").arg(tileId);
+	}
+
+	return {};
+}
+
+QVariant PblvTilesModel::headerData(int section, Qt::Orientation orientation, int role) const {
+	if (!m_doc || !m_doc->isLoaded()) {
+		return {};
+	}
+	if (role != Qt::DisplayRole) {
+		return {};
+	}
+	if (orientation == Qt::Horizontal) {
+		return section;
+	}
+	const int rowsPerBank = (m_doc->tileCount() + m_tilesPerRow - 1) / m_tilesPerRow;
+	const int bank = section / rowsPerBank;
+	const int rowInBank = section % rowsPerBank;
+	const int firstTile = rowInBank * m_tilesPerRow;
+	const quint32 base =
+	    static_cast<quint32>(bank) * static_cast<quint32>(m_doc->tileCount()) + static_cast<quint32>(firstTile);
+	const quint32 last = base + static_cast<quint32>(m_tilesPerRow) - 1u;
+	return QString("%1-%2").arg(base).arg(last);
+}
+
+void PblvTilesModel::_onDocChanged() {
+	if (!m_doc || !m_doc->isLoaded()) {
+		return;
+	}
+	const QModelIndex tl = this->index(0, 0);
+	const QModelIndex br = this->index(rowCount() - 1, columnCount() - 1);
+	emit dataChanged(tl, br, { Qt::DecorationRole, Qt::ToolTipRole });
+}
+
+void PblvTilesModel::_onDocLoaded() {
+	beginResetModel();
+	endResetModel();
+}
