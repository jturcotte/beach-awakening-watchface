@@ -0,0 +1,94 @@
+#include "PblvPalettesModel.h"
+
+#include "PblvDocument.h"
+
+#include <QtGui/QBrush>
+
+PblvPalettesModel::PblvPalettesModel(QObject* parent)
+    : QAbstractTableModel(parent) { }
+
+void PblvPalettesModel::setDocument(PblvDocument* doc) {
+	if (m_doc == doc) {
+		return;
+	}
+	beginResetModel();
+	if (m_doc) {
+		disconnect(m_doc, nullptr, this, nullptr);
+	}
+	m_doc = doc;
+	if (m_doc) {
+		connect(m_doc, &PblvDocument::documentChanged, this, &PblvPalettesModel::_onDocChanged);
+		connect(m_doc, &PblvDocument::documentLoaded, this, &PblvPalettesModel::_onDocLoaded);
+	}
+	endResetModel();
+}
+
+int PblvPalettesModel::rowCount(const QModelIndex& parent) const {
+	if (parent.isValid() || !m_doc || !m_doc->isLoaded()) {
+		return 0;
+	}
+	return 16;
+}
+
+int PblvPalettesModel::columnCount(const QModelIndex& parent) const {
+	if (parent.isValid() || !m_doc || !m_doc->isLoaded()) {
+		return 0;
+	}
+	return 4;
+}
+
+QColor PblvPalettesModel::_qcolorFromGColor8(quint8 g) {
+	const int a2 = (g >> 6) & 3;
+	const int r2 = (g >> 4) & 3;
+	const int g2 = (g >> 2) & 3;
+	const int b2 = (g >> 0) & 3;
+	return QColor(r2 * 85, g2 * 85, b2 * 85, a2 * 85);
+}
+
+QVariant PblvPalettesModel::data(const QModelIndex& index, int role) const {
+	if (!m_doc || !m_doc->isLoaded() || !index.isValid()) {
+		return {};
+	}
+	const int palId = index.row();
+	const int colorId = index.column();
+	const bool isObj = palId >= 8;
+	const int palIndex = isObj ? (palId - 8) : palId;
+	const QVector<quint8> bytes = isObj ? m_doc->objPaletteBytes() : m_doc->bgPaletteBytes();
+	const int idx = palIndex * 4 + colorId;
+	if (idx < 0 || idx >= bytes.size()) {
+		return {};
+	}
+	const quint8 g = bytes[idx];
+
+	if (role == Qt::DisplayRole || role == Qt::ToolTipRole) {
+		return QString("0x%1").arg(g, 2, 16, QLatin1Char('0')).toUpper();
+	}
+	if (role == Qt::BackgroundRole) {
+		return QBrush(_qcolorFromGColor8(g));
+	}
+	return {};
+}
+
+QVariant PblvPalettesModel::headerData(int section, Qt::Orientation orientation, int role) const {
+	if (role != Qt::DisplayRole) {
+		return {};
+	}
+	if (orientation == Qt::Vertical) {
+		return (section < 8) ? QString("BG%1").arg(section) : QString("OBJ%1").arg(section - 8);
+	}
+	return QString("C%1").arg(section);
+}
+
+void PblvPalettesModel::_onDocChanged() {
+	if (!m_doc || !m_doc->isLoaded()) {
+		return;
+	}
+	const QModelIndex tl = this->index(0, 0);
+	const QModelIndex br = this->index(rowCount() - 1, columnCount() - 1);
+	emit dataChanged(tl, br, { Qt::DisplayRole, Qt::ToolTipRole, Qt::BackgroundRole });
+}
+
+void PblvPalettesModel::_onDocLoaded() {
+	beginResetModel();
+	endResetModel();
+}
