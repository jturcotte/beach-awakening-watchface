+
+bool PblvDocument::loadFromFile(const QString& path, QString* errorMessage) {
+	QFile f(path);
+	if (!f.open(QIODevice::ReadOnly)) {
+		_fail(errorMessage, QString("Failed to open file: %1").arg(path));
+		return false;
+	}
+	m_path = path;
+	m_data = f.readAll();
+	if (m_data.isEmpty()) {
+		_fail(errorMessage, QString("Empty file: %1").arg(path));
+		return false;
+	}
+	if (!_parse(errorMessage)) {
+		return false;
+	}
+	emit documentLoaded();
+	return true;
+}
+
+bool PblvDocument::saveToFile(const QString& path, QString* errorMessage) {
+	if (!isLoaded()) {
+		_fail(errorMessage, "No document loaded");
+		return false;
+	}
+	if (!_syncMapIntoData(errorMessage)) {
+		return false;
+	}
+	if (!_syncFramesIntoData(errorMessage)) {
+		return false;
+	}
+	QFile f(path);
+	if (!f.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+		_fail(errorMessage, QString("Failed to write file: %1").arg(path));
+		return false;
+	}
+	if (f.write(m_data) != m_data.size()) {
+		_fail(errorMessage, QString("Short write while saving: %1").arg(path));
+		return false;
+	}
+	m_path = path;
+	return true;
+}
+
+bool PblvDocument::_readU16(const QByteArray& data, int offset, quint16* out) {
+	if (!_hasBytes(data, offset, 2) || !out) {
+		return false;
+	}
+	const quint8 b0 = static_cast<quint8>(data[offset + 0]);
+	const quint8 b1 = static_cast<quint8>(data[offset + 1]);
+	*out = static_cast<quint16>(b0 | (static_cast<quint16>(b1) << 8));
+	return true;
+}
+
+bool PblvDocument::_readU32(const QByteArray& data, int offset, quint32* out) {
+	if (!_hasBytes(data, offset, 4) || !out) {
+		return false;
+	}
+	const quint8 b0 = static_cast<quint8>(data[offset + 0]);
+	const quint8 b1 = static_cast<quint8>(data[offset + 1]);
+	const quint8 b2 = static_cast<quint8>(data[offset + 2]);
+	const quint8 b3 = static_cast<quint8>(data[offset + 3]);
+	*out = static_cast<quint32>(b0) | (static_cast<quint32>(b1) << 8) | (static_cast<quint32>(b2) << 16) |
+	    (static_cast<quint32>(b3) << 24);
+	return true;
+}
+
+void PblvDocument::_writeU16(QByteArray& data, int offset, quint16 v) {
+	if (!_hasBytes(data, offset, 2)) {
+		return;
+	}
+	data[offset + 0] = static_cast<char>(v & 0xFF);
+	data[offset + 1] = static_cast<char>((v >> 8) & 0xFF);
+}
+
+void PblvDocument::_writeU32(QByteArray& data, int offset, quint32 v) {
+	if (!_hasBytes(data, offset, 4)) {
+		return;
+	}
+	data[offset + 0] = static_cast<char>(v & 0xFF);
+	data[offset + 1] = static_cast<char>((v >> 8) & 0xFF);
+	data[offset + 2] = static_cast<char>((v >> 16) & 0xFF);
+	data[offset + 3] = static_cast<char>((v >> 24) & 0xFF);
+}
+
+void PblvDocument::_appendU16(QByteArray& data, quint16 v) {
+	data.append(static_cast<char>(v & 0xFF));
+	data.append(static_cast<char>((v >> 8) & 0xFF));
+}
+
+void PblvDocument::_appendU32(QByteArray& data, quint32 v) {
+	data.append(static_cast<char>(v & 0xFF));
+	data.append(static_cast<char>((v >> 8) & 0xFF));
+	data.append(static_cast<char>((v >> 16) & 0xFF));
+	data.append(static_cast<char>((v >> 24) & 0xFF));
+}
+
+bool PblvDocument::_parse(QString* errorMessage) {
+	m_version = 0;
+	m_headerSize = 0;
+	m_keyframeOffset = 0;
+	m_framesOffset = 0;
+	m_nFrames = 0;
+	m_mapW = 0;
+	m_mapH = 0;
+	m_tileCount = 0;
+	m_bankCount = 0;
+	m_keyframeBase = 0;
+	m_keyframeEnd = 0;
+	m_paletteOffset = 0;
+	m_tileTableOffset = 0;
+	m_mapOffset = 0;
+	m_objPaletteOffset = 0;
+	m_oamOffset = 0;
+	m_bgPaletteBytes.clear();
+	m_objPaletteBytes.clear();
+	m_oamBytes.clear();
+	m_mapTileKeys.clear();
+	m_mapPalettes.clear();
+	m_keyframeBgPaletteBytes.clear();
+	m_keyframeObjPaletteBytes.clear();
+	m_keyframeMapTileKeys.clear();
+	m_keyframeMapPalettes.clear();
+	m_keyframeTileTable.clear();
+	m_keyframeOamBytes.clear();
+	m_frames.clear();
+	m_framesDirty = false;
+	m_previewActive = false;
+	m_previewBgPaletteBytes.clear();
+	m_previewObjPaletteBytes.clear();
+	m_previewMapTileKeys.clear();
+	m_previewMapPalettes.clear();
+	m_previewTileTable.clear();
+	m_previewOamBytes.clear();
+	m_previewAnimatedMap.clear();
+	m_previewAnimatedSprites.clear();
+	m_lcdc = 0;
+	m_isCgb = false;
+
+	if (!_hasBytes(m_data, 0, 32)) {
+		_fail(errorMessage, "File too small for PBLV header");
+		return false;
+	}
+	if (m_data.mid(0, 4) != QByteArray("PBLV", 4)) {
+		_fail(errorMessage, "Not a PBLV file (missing magic)");
+		return false;
+	}
+	if (!_readU16(m_data, 0x04, &m_version) || m_version != 1) {
+		_fail(errorMessage, "Unsupported PBLV version");
+		return false;
+	}
+	if (!_readU16(m_data, 0x06, &m_headerSize) || m_headerSize != 32) {
+		_fail(errorMessage, "Unexpected header size");
+		return false;
+	}
+	if (!_readU32(m_data, 0x08, &m_keyframeOffset)) {
+		_fail(errorMessage, "Failed to read keyframeOffset");
+		return false;
+	}
+	if (!_readU32(m_data, 0x0C, &m_framesOffset)) {
+		_fail(errorMessage, "Failed to read framesOffset");
+		return false;
+	}
+	if (!_readU32(m_data, 0x10, &m_nFrames)) {
+		_fail(errorMessage, "Failed to read nFrames");
+		return false;
+	}
+	if (!_readU16(m_data, 0x14, &m_mapW) || !_readU16(m_data, 0x16, &m_mapH)) {
+		_fail(errorMessage, "Failed to read mapW/mapH");
+		return false;
+	}
+	if (!_rebuildKeyframeOffsets(errorMessage)) {
+		return false;
+	}
+	return _parseFrames(errorMessage);
+}
+
+bool PblvDocument::_rebuildKeyframeOffsets(QString* errorMessage) {
+	const int base = static_cast<int>(m_keyframeOffset);
+	if (!_hasBytes(m_data, base, 8 + 8)) {
+		_fail(errorMessage, "Keyframe truncated");
+		return false;
+	}
+	if (m_data.mid(base, 4) != QByteArray("KEYF", 4)) {
+		_fail(errorMessage, "Missing KEYF tag");
+		return false;
+	}
+	// Skip tag+length
+	int o = base + 8;
+
+	// Keyframe parameters (8 bytes)
+	if (!_hasBytes(m_data, o, 8)) {
+		_fail(errorMessage, "Keyframe parameters truncated");
+		return false;
+	}
+	m_isCgb = static_cast<quint8>(m_data[o + 0]) != 0;
+	m_lcdc = static_cast<quint8>(m_data[o + 1]);
+	// byte 5 = tileDataSelect
+	m_tileDataSelect = static_cast<quint8>(m_data[o + 5]);
+	o += 8;
+
+	// tileCount/bankCount/mapW/mapH/reserved0/reserved1 (12 bytes)
+	if (!_readU16(m_data, o + 0, &m_tileCount) || !_readU16(m_data, o + 2, &m_bankCount)) {
+		_fail(errorMessage, "Failed to read tileCount/bankCount");
+		return false;
+	}
+	quint16 keyMapW = 0;
+	quint16 keyMapH = 0;
+	if (!_readU16(m_data, o + 4, &keyMapW) || !_readU16(m_data, o + 6, &keyMapH)) {
+		_fail(errorMessage, "Failed to read keyframe mapW/mapH");
+		return false;
+	}
+	if (keyMapW != m_mapW || keyMapH != m_mapH) {
+		_fail(errorMessage, "Header mapW/mapH mismatch keyframe mapW/mapH");
+		return false;
+	}
+	o += 12;
+
+	// BG palettes
+	quint16 nPaletteBytes = 0;
+	if (!_readU16(m_data, o, &nPaletteBytes)) {
+		_fail(errorMessage, "Failed to read nPaletteBytes");
+		return false;
+	}
+	o += 2;
+	if (nPaletteBytes != 32) {
+		_fail(errorMessage, "Unexpected palette byte count (expected 32)");
+		return false;
+	}
+	m_paletteOffset = o;
+	if (!_hasBytes(m_data, m_paletteOffset, 32)) {
+		_fail(errorMessage, "Palette data truncated");
+		return false;
+	}
+	m_bgPaletteBytes.resize(32);
+	for (int i = 0; i < 32; ++i) {
+		m_bgPaletteBytes[i] = static_cast<quint8>(m_data[m_paletteOffset + i]);
+	}
+	o += 32;
+
+	// Tile table
+	const int tileSize = static_cast<int>(tileBytesPerTile());
+	const int tileTableBytes = static_cast<int>(m_bankCount) * static_cast<int>(m_tileCount) * tileSize;
+	m_tileTableOffset = o;
+	if (!_hasBytes(m_data, m_tileTableOffset, tileTableBytes)) {
+		_fail(errorMessage, "Tile table truncated");
+		return false;
+	}
+	o += tileTableBytes;
+
+	// Map table
+	m_mapOffset = o;
+	const int mapCells = static_cast<int>(m_mapW) * static_cast<int>(m_mapH);
+	const int mapBytes = mapCells * m_mapStride;
+	const int keyframeEnd = (m_framesOffset != 0) ? static_cast<int>(m_framesOffset) : m_data.size();
+	if (m_mapOffset + mapBytes > keyframeEnd || !_hasBytes(m_data, m_mapOffset, mapBytes)) {
+		_fail(errorMessage, "Map data truncated");
+		return false;
+	}
+	m_mapTileKeys.resize(mapCells);
+	m_mapPalettes.resize(mapCells);
+	for (int i = 0; i < mapCells; ++i) {
+		const int cellOff = m_mapOffset + i * m_mapStride;
+		quint16 tileKey = 0;
+		if (!_readU16(m_data, cellOff + 0, &tileKey)) {
+			_fail(errorMessage, "Failed reading map tileKey");
+			return false;
+		}
+		const quint8 pal = static_cast<quint8>(m_data[cellOff + 2]);
+		m_mapTileKeys[i] = tileKey;
+		m_mapPalettes[i] = static_cast<quint8>(pal & 7);
+	}
+	o += mapBytes;
+
+	// Optional OBJ palettes
+	if (o + 2 <= keyframeEnd && _hasBytes(m_data, o, 2)) {
+		quint16 nObjPaletteBytes = 0;
+		if (!_readU16(m_data, o, &nObjPaletteBytes)) {
+			_fail(errorMessage, "Failed to read nObjPaletteBytes");
+			return false;
+		}
+		o += 2;
+		if (nObjPaletteBytes != 32) {
+			_fail(errorMessage, "Unexpected OBJ palette byte count (expected 32)");
+			return false;
+		}
+		if (o + 32 > keyframeEnd || !_hasBytes(m_data, o, 32)) {
+			_fail(errorMessage, "OBJ palette data truncated");
+			return false;
+		}
+		m_objPaletteOffset = o;
+		m_objPaletteBytes.resize(32);
+		for (int i = 0; i < 32; ++i) {
+			m_objPaletteBytes[i] = static_cast<quint8>(m_data[o + i]);
+		}
+		o += 32;
+	}
+
+	// Optional OAM bytes
+	if (o + 2 <= keyframeEnd && _hasBytes(m_data, o, 2)) {
+		quint16 oamBytes = 0;
+		if (!_readU16(m_data, o, &oamBytes)) {
+			_fail(errorMessage, "Failed to read oamBytes");
+			return false;
+		}
+		o += 2;
+		if (oamBytes > 0) {
+			if (o + oamBytes > keyframeEnd || !_hasBytes(m_data, o, oamBytes)) {
+				_fail(errorMessage, "OAM data truncated");
+				return false;
+			}
+			m_oamOffset = o;
+			m_oamBytes = m_data.mid(o, oamBytes);
+			o += oamBytes;
+		}
+	}
+
+	m_keyframeEnd = o;
+	m_keyframeBgPaletteBytes = m_bgPaletteBytes;
+	m_keyframeObjPaletteBytes = m_objPaletteBytes;
+	m_keyframeMapTileKeys = m_mapTileKeys;
+	m_keyframeMapPalettes = m_mapPalettes;
+	if (m_tileTableOffset > 0) {
+		const int tileSize = static_cast<int>(tileBytesPerTile());
+		const int tileTableBytes = static_cast<int>(m_bankCount) * static_cast<int>(m_tileCount) * tileSize;
+		if (_hasBytes(m_data, m_tileTableOffset, tileTableBytes)) {
+			m_keyframeTileTable = QByteArray(m_data.constData() + m_tileTableOffset, tileTableBytes);
+		}
+	}
+	if (m_oamBytes.size() > 0) {
+		m_keyframeOamBytes = m_oamBytes;
+	}
+
+	m_keyframeBase = base;
+	return true;
+}
+
+bool PblvDocument::_parseFrames(QString* errorMessage) {
+	m_frames.clear();
+	if (m_framesOffset == 0 || m_nFrames == 0) {
+		return true;
+	}
+	int o = static_cast<int>(m_framesOffset);
+	for (quint32 fi = 0; fi < m_nFrames; ++fi) {
+		if (!_hasBytes(m_data, o, 12)) {
+			_fail(errorMessage, "Frame header truncated");
+			return false;
+		}
+		quint16 delta = 0;
+		quint16 nPal = 0;
+		quint16 nTile = 0;
+		quint16 nMap = 0;
+		quint16 nObjPal = 0;
+		quint16 nOam = 0;
+		if (!_readU16(m_data, o + 0, &delta) || !_readU16(m_data, o + 2, &nPal) || !_readU16(m_data, o + 4, &nTile) ||
+		    !_readU16(m_data, o + 6, &nMap) || !_readU16(m_data, o + 8, &nObjPal) || !_readU16(m_data, o + 10, &nOam)) {
+			_fail(errorMessage, "Failed reading frame header");
+			return false;
+		}
+		o += 12;
+
+		PblvFrameRecord frame;
+		frame.deltaFrames = delta;
+
+		for (int i = 0; i < nPal; ++i) {
+			if (!_hasBytes(m_data, o, 4)) {
+				_fail(errorMessage, "Palette update truncated");
+				return false;
+			}
+			PblvPalUpdate u;
+			u.palette = static_cast<quint8>(m_data[o + 0]);
+			u.color = static_cast<quint8>(m_data[o + 1]);
+			u.gcolor = static_cast<quint8>(m_data[o + 2]);
+			frame.palUpdates.append(u);
+			o += 4;
+		}
+
+		for (int i = 0; i < nTile; ++i) {
+			if (!_hasBytes(m_data, o, 2 + 2 + 64)) {
+				_fail(errorMessage, "Tile update truncated");
+				return false;
+			}
+			quint16 tileKey = 0;
+			if (!_readU16(m_data, o + 0, &tileKey)) {
+				_fail(errorMessage, "Failed reading tileKey");
+				return false;
+			}
+			PblvTileUpdate u;
+			u.tileKey = tileKey;
+			u.data = QByteArray(m_data.constData() + o + 4, 64);
+			frame.tileUpdates.append(u);
+			o += 2 + 2 + 64;
+		}
+
+		for (int i = 0; i < nMap; ++i) {
+			if (!_hasBytes(m_data, o, 6)) {
+				_fail(errorMessage, "Map update truncated");
+				return false;
+			}
+			PblvMapUpdate u;
+			if (!_readU16(m_data, o + 0, &u.mapIndex) || !_readU16(m_data, o + 2, &u.tileKey)) {
+				_fail(errorMessage, "Failed reading map update");
+				return false;
+			}
+			u.palette = static_cast<quint8>(m_data[o + 4]);
+			frame.mapUpdates.append(u);
+			o += 6;
+		}
+
+		for (int i = 0; i < nObjPal; ++i) {
+			if (!_hasBytes(m_data, o, 4)) {
+				_fail(errorMessage, "OBJ palette update truncated");
+				return false;
+			}
+			PblvPalUpdate u;
+			u.palette = static_cast<quint8>(m_data[o + 0]);
+			u.color = static_cast<quint8>(m_data[o + 1]);
+			u.gcolor = static_cast<quint8>(m_data[o + 2]);
+			frame.objPalUpdates.append(u);
+			o += 4;
+		}
+
+		for (int i = 0; i < nOam; ++i) {
+			if (!_hasBytes(m_data, o, 8)) {
+				_fail(errorMessage, "OAM update truncated");
+				return false;
+			}
+			PblvOamUpdate u;
+			if (!_readU16(m_data, o + 0, &u.index)) {
+				_fail(errorMessage, "Failed reading OAM update index");
+				return false;
+			}
+			u.data[0] = static_cast<quint8>(m_data[o + 4]);
+			u.data[1] = static_cast<quint8>(m_data[o + 5]);
+			u.data[2] = static_cast<quint8>(m_data[o + 6]);
+			u.data[3] = static_cast<quint8>(m_data[o + 7]);
+			frame.oamUpdates.append(u);
+			o += 8;
+		}
+
+		m_frames.append(frame);
+	}
+	return true;
+}
+
+void PblvDocument::_applyFrameToPreview(const PblvFrameRecord& frame) {
+	for (const auto& u : frame.palUpdates) {
+		const int idx = (u.palette & 7) * 4 + (u.color & 3);
+		if (idx >= 0 && idx < m_previewBgPaletteBytes.size()) {
+			m_previewBgPaletteBytes[idx] = u.gcolor;
+		}
+	}
+	for (const auto& u : frame.objPalUpdates) {
+		const int idx = (u.palette & 7) * 4 + (u.color & 3);
+		if (idx >= 0 && idx < m_previewObjPaletteBytes.size()) {
+			m_previewObjPaletteBytes[idx] = u.gcolor;
+		}
+	}
+	for (const auto& u : frame.tileUpdates) {
+		const int tileSize = static_cast<int>(tileBytesPerTile());
+		const int tilesPerBankBytes = static_cast<int>(m_tileCount) * tileSize;
+		const int bank = (u.tileKey >> 15) & 1;
+		const int tileIndex = u.tileKey & 0x7FFF;
+		const int offset = bank * tilesPerBankBytes + tileIndex * tileSize;
+		if (_hasBytes(m_previewTileTable, offset, tileSize) && u.data.size() == tileSize) {
+			memcpy(m_previewTileTable.data() + offset, u.data.constData(), tileSize);
+		}
+	}
+	for (const auto& u : frame.mapUpdates) {
+		if (u.mapIndex < m_previewMapTileKeys.size()) {
+			m_previewMapTileKeys[u.mapIndex] = u.tileKey;
+		}
+		if (u.mapIndex < m_previewMapPalettes.size()) {
+			m_previewMapPalettes[u.mapIndex] = static_cast<quint8>(u.palette & 7);
+		}
+	}
+	for (const auto& u : frame.oamUpdates) {
+		const int off = static_cast<int>(u.index) * 4;
+		if (_hasBytes(m_previewOamBytes, off, 4)) {
+			m_previewOamBytes[off + 0] = static_cast<char>(u.data[0]);
+			m_previewOamBytes[off + 1] = static_cast<char>(u.data[1]);
+			m_previewOamBytes[off + 2] = static_cast<char>(u.data[2]);
+			m_previewOamBytes[off + 3] = static_cast<char>(u.data[3]);
+		}
+	}
+}
+
+bool PblvDocument::_syncMapIntoData(QString* errorMessage) {
+	if (!isLoaded()) {
+		_fail(errorMessage, "No document loaded");
+		return false;
+	}
+	const int mapCells = static_cast<int>(m_mapW) * static_cast<int>(m_mapH);
+	if (m_mapTileKeys.size() != mapCells || m_mapPalettes.size() != mapCells) {
+		_fail(errorMessage, "Internal map size mismatch");
+		return false;
+	}
+	const int mapBytes = mapCells * m_mapStride;
+	if (!_hasBytes(m_data, m_mapOffset, mapBytes)) {
+		_fail(errorMessage, "Map offset out of range");
+		return false;
+	}
+	for (int i = 0; i < mapCells; ++i) {
+		const int cellOff = m_mapOffset + i * m_mapStride;
+		_writeU16(m_data, cellOff + 0, m_mapTileKeys[i]);
+		m_data[cellOff + 2] = static_cast<char>(m_mapPalettes[i] & 7);
+		m_data[cellOff + 3] = 0;
+	}
+	return true;
+}
+
+bool PblvDocument::_syncFramesIntoData(QString* errorMessage) {
+	if (!isLoaded()) {
+		_fail(errorMessage, "No document loaded");
+		return false;
+	}
+	if (m_keyframeEnd <= 0) {
+		_fail(errorMessage, "Keyframe end offset invalid");
+		return false;
+	}
+	QByteArray out = m_data.left(m_keyframeEnd);
+	QByteArray framesData;
+	const quint32 nFrames = static_cast<quint32>(m_frames.size());
+	quint32 framesOffset = 0;
+	if (nFrames > 0) {
+		framesOffset = static_cast<quint32>(m_keyframeEnd);
+		for (const auto& frame : m_frames) {
+			_appendU16(framesData, frame.deltaFrames);
+			_appendU16(framesData, static_cast<quint16>(frame.palUpdates.size()));
+			_appendU16(framesData, static_cast<quint16>(frame.tileUpdates.size()));
+			_appendU16(framesData, static_cast<quint16>(frame.mapUpdates.size()));
+			_appendU16(framesData, static_cast<quint16>(frame.objPalUpdates.size()));
+			_appendU16(framesData, static_cast<quint16>(frame.oamUpdates.size()));
+
+			for (const auto& u : frame.palUpdates) {
+				framesData.append(static_cast<char>(u.palette));
+				framesData.append(static_cast<char>(u.color));
+				framesData.append(static_cast<char>(u.gcolor));
+				framesData.append(static_cast<char>(0));
+			}
+			for (const auto& u : frame.tileUpdates) {
+				_appendU16(framesData, u.tileKey);
+				_appendU16(framesData, 0);
+				framesData.append(u.data);
+			}
+			for (const auto& u : frame.mapUpdates) {
+				_appendU16(framesData, u.mapIndex);
+				_appendU16(framesData, u.tileKey);
+				framesData.append(static_cast<char>(u.palette));
+				framesData.append(static_cast<char>(0));
+			}
+			for (const auto& u : frame.objPalUpdates) {
+				framesData.append(static_cast<char>(u.palette));
+				framesData.append(static_cast<char>(u.color));
+				framesData.append(static_cast<char>(u.gcolor));
+				framesData.append(static_cast<char>(0));
+			}
+			for (const auto& u : frame.oamUpdates) {
+				_appendU16(framesData, u.index);
+				_appendU16(framesData, 0);
+				framesData.append(static_cast<char>(u.data[0]));
+				framesData.append(static_cast<char>(u.data[1]));
+				framesData.append(static_cast<char>(u.data[2]));
+				framesData.append(static_cast<char>(u.data[3]));
+			}
+		}
+		out.append(framesData);
+	}
+	_writeU32(out, 0x0C, framesOffset);
+	_writeU32(out, 0x10, nFrames);
+	m_data = out;
+	m_framesOffset = framesOffset;
+	m_nFrames = nFrames;
+	m_framesDirty = false;
+	return true;
+}
diff --git a/src/platform/qt/pblv/PblvDocument.h b/src/platform/qt/pblv/PblvDocument.h
new file mode 100644
index 000000000..e70ebfa6c
--- /dev/null
+++ b/src/platform/qt/pblv/PblvDocument.h
@@ -0,0 +1,164 @@
+#pragma once
+
+#include <QtCore/QByteArray>
+#include <QtCore/QObject>
+#include <QtCore/QRect>
+#include <QtCore/QString>
+#include <QtCore/QVector>
+
+class PblvDocument : public QObject {
+	Q_OBJECT
+
+public:
+	struct PblvPalUpdate {
+		quint8 palette = 0;
+		quint8 color = 0;
+		quint8 gcolor = 0;
+	};
+	struct PblvTileUpdate {
+		quint16 tileKey = 0;
+		QByteArray data; // 64 bytes
+	};
+	struct PblvMapUpdate {
+		quint16 mapIndex = 0;
+		quint16 tileKey = 0;
+		quint8 palette = 0;
+	};
+	struct PblvOamUpdate {
+		quint16 index = 0;
+		quint8 data[4] = { 0, 0, 0, 0 };
+	};
+	struct PblvFrameRecord {
+		quint16 deltaFrames = 0;
+		QVector<PblvPalUpdate> palUpdates;
+		QVector<PblvTileUpdate> tileUpdates;
+		QVector<PblvMapUpdate> mapUpdates;
+		QVector<PblvPalUpdate> objPalUpdates;
+		QVector<PblvOamUpdate> oamUpdates;
+	};
+
+	explicit PblvDocument(QObject* parent = nullptr);
+
+	bool loadFromFile(const QString& path, QString* errorMessage = nullptr);
+	bool saveToFile(const QString& path, QString* errorMessage = nullptr);
+
+	bool isLoaded() const;
+	QString filePath() const;
+
+	quint16 mapW() const;
+	quint16 mapH() const;
+	quint16 tileCount() const;
+	quint16 bankCount() const;
+	quint16 tileW() const;
+	quint16 tileH() const;
+	quint16 tileBytesPerTile() const;
+	bool isCgb() const;
+	quint8 lcdc() const;
+	int spriteHeight() const;
+
+	// Pebble-centric tile identifier: a single index into the concatenated tile table.
+	// tileId = bank * tileCount + tileIndex
+	quint32 tileIdFromTileKey(quint16 tileKey) const;
+	bool tileKeyFromTileId(quint32 tileId, quint16* outTileKey) const;
+
+	QVector<quint8> bgPaletteBytes() const; // size 32, GColor8
+	QVector<quint8> objPaletteBytes() const; // size 32, GColor8
+	int spriteCount() const;
+	bool spriteRaw(int index, quint8* outY, quint8* outX, quint8* outTile, quint8* outAttr) const;
+	bool setSpriteRaw(int index, quint8 y, quint8 x, quint8 tile, quint8 attr);
+	bool setBgPaletteEntry(int paletteId, int colorId, quint8 gcolor);
+	bool setObjPaletteEntry(int paletteId, int colorId, quint8 gcolor);
+	quint16 mapTileKey(int x, int y) const;
+	quint8 mapPalette(int x, int y) const;
+	void setMapCell(int x, int y, quint16 tileKey, quint8 palette);
+
+	// Raw tile pixels: Pebble-packed 2bpp tiles, 16x16 (64 bytes).
+	bool tilePixels(quint16 bank, quint16 tileIndex, const quint8** outPtr) const;
+	bool setTilePixel(quint16 bank, quint16 tileIndex, int x, int y, quint8 value);
+	bool cycleTilePixels(quint16 bank, quint16 tileIndex, const QRect& rect, int delta);
+
+	int frameCount() const;
+	const PblvFrameRecord* frame(int index) const;
+	bool removeFrame(int index);
+	bool removeMapUpdate(int frameIndex, int updateIndex);
+	bool removeOamUpdate(int frameIndex, int updateIndex);
+
+	bool setPreviewFrame(int frameIndex);
+	void clearPreviewFrame();
+	QVector<int> previewAnimatedMap() const;
+	QVector<int> previewAnimatedSprites() const;
+	void setPreviewAnimatedMap(const QVector<int>& mapIndices);
+	void setPreviewAnimatedSprites(const QVector<int>& spriteIndices);
+
+signals:
+	void documentChanged();
+	void documentLoaded();
+	void framesChanged();
+
+private:
+	static bool _readU16(const QByteArray& data, int offset, quint16* out);
+	static bool _readU32(const QByteArray& data, int offset, quint32* out);
+	static void _writeU16(QByteArray& data, int offset, quint16 v);
+	static void _writeU32(QByteArray& data, int offset, quint32 v);
+	static void _appendU16(QByteArray& data, quint16 v);
+	static void _appendU32(QByteArray& data, quint32 v);
+
+	bool _parse(QString* errorMessage);
+	bool _rebuildKeyframeOffsets(QString* errorMessage);
+	bool _parseFrames(QString* errorMessage);
+	bool _syncMapIntoData(QString* errorMessage);
+	bool _syncFramesIntoData(QString* errorMessage);
+	void _applyFrameToPreview(const PblvFrameRecord& frame);
+
+	QString m_path;
+	QByteArray m_data;
+
+	quint16 m_version = 0;
+	quint16 m_headerSize = 0;
+	quint32 m_keyframeOffset = 0;
+	quint32 m_framesOffset = 0;
+	quint32 m_nFrames = 0;
+
+	quint16 m_mapW = 0;
+	quint16 m_mapH = 0;
+	quint16 m_tileCount = 0;
+	quint16 m_bankCount = 0;
+	quint8 m_tileDataSelect = 0;
+	quint8 m_lcdc = 0;
+	bool m_isCgb = false;
+
+	int m_keyframeBase = 0;
+	int m_keyframeEnd = 0;
+	int m_paletteOffset = 0;
+	int m_tileTableOffset = 0;
+	int m_mapOffset = 0;
+	int m_objPaletteOffset = 0;
+	int m_oamOffset = 0;
+	int m_mapStride = 4;
+
+	QVector<quint8> m_bgPaletteBytes;
+	QVector<quint8> m_objPaletteBytes;
+	QByteArray m_oamBytes;
+	QVector<quint16> m_mapTileKeys; // size mapW*mapH
+	QVector<quint8> m_mapPalettes; // size mapW*mapH
+
+	QVector<quint8> m_keyframeBgPaletteBytes;
+	QVector<quint8> m_keyframeObjPaletteBytes;
+	QVector<quint16> m_keyframeMapTileKeys;
+	QVector<quint8> m_keyframeMapPalettes;
+	QByteArray m_keyframeTileTable;
+	QByteArray m_keyframeOamBytes;
+
+	QVector<PblvFrameRecord> m_frames;
+	bool m_framesDirty = false;
+
+	bool m_previewActive = false;
+	QVector<quint8> m_previewBgPaletteBytes;
+	QVector<quint8> m_previewObjPaletteBytes;
+	QVector<quint16> m_previewMapTileKeys;
+	QVector<quint8> m_previewMapPalettes;
+	QByteArray m_previewTileTable;
+	QByteArray m_previewOamBytes;
+	QVector<int> m_previewAnimatedMap;
+	QVector<int> m_previewAnimatedSprites;
+};
diff --git a/src/platform/qt/pblv/PblvMainWindow.cpp b/src/platform/qt/pblv/PblvMainWindow.cpp
new file mode 100644
index 000000000..4e3b404d9
--- /dev/null
+++ b/src/platform/qt/pblv/PblvMainWindow.cpp
@@ -0,0 +1,207 @@
+#include "PblvMainWindow.h"
+
+#include "PblvDocument.h"
+#include "PblvFramesWindow.h"
+#include "PblvMapWindow.h"
+#include "PblvPalettesWindow.h"
+#include "PblvSpritesWindow.h"
+#include "PblvTileMapWidget.h"
+#include "PblvTilesWindow.h"
+
+#include <QtWidgets/QAction>
+#include <QtWidgets/QDockWidget>
+#include <QtWidgets/QFileDialog>
+#include <QtWidgets/QFormLayout>
+#include <QtWidgets/QLabel>
+#include <QtWidgets/QMenu>
+#include <QtWidgets/QMenuBar>
+#include <QtWidgets/QMessageBox>
+
+PblvMainWindow::PblvMainWindow(QWidget* parent)
+    : QMainWindow(parent) {
+	setWindowTitle("PBLV Editor");
+
+	m_doc = new PblvDocument(this);
+	m_view = new PblvTileMapWidget(this);
+	setCentralWidget(m_view);
+	m_view->setDocument(m_doc);
+
+	auto* info = new QWidget(this);
+	auto* form = new QFormLayout(info);
+	form->setContentsMargins(8, 8, 8, 8);
+	m_selLabel = new QLabel("(no selection)", info);
+	m_selLabel->setTextInteractionFlags(Qt::TextSelectableByMouse);
+	form->addRow("Selected", m_selLabel);
+
+	auto* dock = new QDockWidget("Map Cell", this);
+	dock->setObjectName("pblvMapCellDock");
+	dock->setWidget(info);
+	addDockWidget(Qt::RightDockWidgetArea, dock);
+
+	m_mapWindow = new PblvMapWindow();
+	m_mapWindow->setDocument(m_doc);
+	m_mapWindow->show();
+	connect(m_mapWindow, &PblvMapWindow::selectedCellChanged, this, &PblvMainWindow::onSelectedCellChanged);
+	connect(m_mapWindow, &PblvMapWindow::selectedCellsChanged, this, [this](const QVector<QPoint>& cells) {
+		if (m_view) {
+			m_view->setSelectedCells(cells);
+		}
+	});
+
+	m_tilesWindow = new PblvTilesWindow();
+	m_tilesWindow->setDocument(m_doc);
+	m_tilesWindow->show();
+
+	m_palettesWindow = new PblvPalettesWindow();
+	m_palettesWindow->setDocument(m_doc);
+	m_palettesWindow->show();
+
+	m_spritesWindow = new PblvSpritesWindow();
+	m_spritesWindow->setDocument(m_doc);
+	m_spritesWindow->show();
+	connect(m_spritesWindow, &PblvSpritesWindow::selectedSpritesChanged, this, [this](const QVector<int>& indices) {
+		if (m_view) {
+			m_view->setSelectedSprites(indices);
+		}
+	});
+
+	m_framesWindow = new PblvFramesWindow();
+	m_framesWindow->setDocument(m_doc);
+	m_framesWindow->show();
+	connect(m_framesWindow, &PblvFramesWindow::selectionChanged, this, [this](const PblvFramesModel::Selection& sel) {
+		if (!m_doc || !m_view || !m_doc->isLoaded()) {
+			return;
+		}
+		if (sel.frameIndex < 0) {
+			m_doc->clearPreviewFrame();
+			m_view->setAnimatedMapCells({});
+			m_view->setAnimatedSprites({});
+			return;
+		}
+		m_doc->setPreviewFrame(sel.frameIndex);
+		QVector<int> mapIndices;
+		QVector<int> spriteIndices;
+		const auto* frame = m_doc->frame(sel.frameIndex);
+		if (!frame) {
+			m_view->setAnimatedMapCells({});
+			m_view->setAnimatedSprites({});
+			return;
+		}
+		auto addMapForTile = [this, &mapIndices](quint16 tileKey) {
+			const int w = m_doc->mapW();
+			const int h = m_doc->mapH();
+			for (int y = 0; y < h; ++y) {
+				for (int x = 0; x < w; ++x) {
+					if (m_doc->mapTileKey(x, y) == tileKey) {
+						mapIndices.append(x + y * w);
+					}
+				}
+			}
+		};
+		if (sel.isFrame) {
+			for (const auto& u : frame->mapUpdates) {
+				mapIndices.append(u.mapIndex);
+			}
+			for (const auto& u : frame->oamUpdates) {
+				spriteIndices.append(u.index);
+			}
+			for (const auto& u : frame->tileUpdates) {
+				addMapForTile(u.tileKey);
+			}
+		} else {
+			switch (sel.updateType) {
+			case PblvFramesModel::UpdateMap:
+				if (sel.updateIndex >= 0 && sel.updateIndex < frame->mapUpdates.size()) {
+					mapIndices.append(frame->mapUpdates[sel.updateIndex].mapIndex);
+				}
+				break;
+			case PblvFramesModel::UpdateOam:
+				if (sel.updateIndex >= 0 && sel.updateIndex < frame->oamUpdates.size()) {
+					spriteIndices.append(frame->oamUpdates[sel.updateIndex].index);
+				}
+				break;
+			case PblvFramesModel::UpdateTile:
+				if (sel.updateIndex >= 0 && sel.updateIndex < frame->tileUpdates.size()) {
+					addMapForTile(frame->tileUpdates[sel.updateIndex].tileKey);
+				}
+				break;
+			default:
+				break;
+			}
+		}
+		m_view->setAnimatedMapCells(mapIndices);
+		m_view->setAnimatedSprites(spriteIndices);
+	});
+
+	QMenu* fileMenu = menuBar()->addMenu("File");
+	QAction* openAct = fileMenu->addAction("Open...");
+	QAction* saveAct = fileMenu->addAction("Save");
+	fileMenu->addSeparator();
+	QAction* exitAct = fileMenu->addAction("Exit");
+
+	connect(openAct, &QAction::triggered, this, &PblvMainWindow::openFile);
+	connect(saveAct, &QAction::triggered, this, &PblvMainWindow::saveFile);
+	connect(exitAct, &QAction::triggered, this, &QWidget::close);
+}
+
+bool PblvMainWindow::openPath(const QString& path) {
+	if (path.isEmpty()) {
+		return false;
+	}
+	QString err;
+	if (!m_doc->loadFromFile(path, &err)) {
+		_showError(err);
+		return false;
+	}
+	_setLoadedPath(path);
+	return true;
+}
+
+void PblvMainWindow::onSelectedCellChanged(int x, int y) {
+	if (!m_doc || !m_doc->isLoaded() || !m_selLabel) {
+		return;
+	}
+	const quint16 tileKey = m_doc->mapTileKey(x, y);
+	const quint8 palette = m_doc->mapPalette(x, y);
+	const quint32 tileId = m_doc->tileIdFromTileKey(tileKey);
+	m_selLabel->setText(QString("x=%1 y=%2  tileId=%3  palette=%4").arg(x).arg(y).arg(tileId).arg(palette));
+}
+
+void PblvMainWindow::_showError(const QString& message) {
+	QMessageBox::critical(this, "PBLV Editor", message);
+}
+
+void PblvMainWindow::_setLoadedPath(const QString& path) {
+	m_loadedPath = path;
+	setWindowTitle(QString("PBLV Editor - %1").arg(m_loadedPath));
+	if (m_mapWindow) {
+		m_mapWindow->setWindowTitle(QString("PBLV Map - %1").arg(m_loadedPath));
+	}
+	if (m_spritesWindow) {
+		m_spritesWindow->setWindowTitle(QString("PBLV Sprites - %1").arg(m_loadedPath));
+	}
+	if (m_framesWindow) {
+		m_framesWindow->setWindowTitle(QString("PBLV Frames - %1").arg(m_loadedPath));
+	}
+}
+
+void PblvMainWindow::openFile() {
+	const QString path =
+	    QFileDialog::getOpenFileName(this, "Open PBLV", QString(), "PBLV files (*.pblv);;All files (*)");
+	if (path.isEmpty()) {
+		return;
+	}
+	openPath(path);
+}
+
+void PblvMainWindow::saveFile() {
+	if (m_loadedPath.isEmpty()) {
+		_showError("No file loaded");
+		return;
+	}
+	QString err;
+	if (!m_doc->saveToFile(m_loadedPath, &err)) {
+		_showError(err);
+		return;
+	}
+}
