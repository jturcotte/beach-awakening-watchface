+#include "PblvPalettesWindow.h"
+
+#include "PblvDocument.h"
+#include "PblvPalettesModel.h"
+
+#include <QtGui/QPainter>
+#include <QtWidgets/QHeaderView>
+#include <QtWidgets/QLabel>
+#include <QtWidgets/QSlider>
+#include <QtWidgets/QStyledItemDelegate>
+#include <QtWidgets/QTableView>
+#include <QtWidgets/QVBoxLayout>
+#include <QtWidgets/QWidget>
+
+namespace {
+class PblvPaletteSelectionDelegate final : public QStyledItemDelegate {
+public:
+	explicit PblvPaletteSelectionDelegate(QObject* parent = nullptr)
+	    : QStyledItemDelegate(parent) { }
+
+	void paint(QPainter* painter, const QStyleOptionViewItem& option, const QModelIndex& index) const override {
+		QStyledItemDelegate::paint(painter, option, index);
+		if (!(option.state & QStyle::State_Selected)) {
+			return;
+		}
+		QColor bg;
+		QVariant v = index.data(Qt::BackgroundRole);
+		if (v.canConvert<QBrush>()) {
+			bg = v.value<QBrush>().color();
+		}
+		const int y = (bg.red() * 299 + bg.green() * 587 + bg.blue() * 114) / 1000;
+		const QColor border = (y < 128) ? QColor(255, 255, 255) : QColor(0, 0, 0);
+		QPen pen(border);
+		pen.setCosmetic(true);
+		pen.setWidth(2);
+		painter->save();
+		painter->setPen(pen);
+		painter->setBrush(Qt::NoBrush);
+		painter->drawRect(option.rect.adjusted(1, 1, -2, -2));
+		painter->restore();
+	}
+};
+
+QSlider* _make2BitSlider(QWidget* parent, const QString& name) {
+	QSlider* s = new QSlider(Qt::Horizontal, parent);
+	s->setObjectName(name);
+	s->setRange(0, 3);
+	s->setSingleStep(1);
+	s->setPageStep(1);
+	s->setTickInterval(1);
+	s->setTickPosition(QSlider::TicksBelow);
+	return s;
+}
+} // namespace
+
+PblvPalettesWindow::PblvPalettesWindow(QWidget* parent)
+    : QMainWindow(parent) {
+	setWindowTitle("PBLV Palettes");
+
+	QWidget* root = new QWidget(this);
+	QHBoxLayout* row = new QHBoxLayout(root);
+	row->setContentsMargins(8, 8, 8, 8);
+	row->setSpacing(8);
+
+	m_view = new QTableView(root);
+	m_model = new PblvPalettesModel(this);
+	m_view->setModel(m_model);
+	m_view->setSelectionMode(QAbstractItemView::ExtendedSelection);
+	m_view->setSelectionBehavior(QAbstractItemView::SelectItems);
+	m_view->setEditTriggers(QAbstractItemView::NoEditTriggers);
+	m_view->setItemDelegate(new PblvPaletteSelectionDelegate(m_view));
+	m_view->horizontalHeader()->setSectionResizeMode(QHeaderView::ResizeToContents);
+	m_view->verticalHeader()->setSectionResizeMode(QHeaderView::ResizeToContents);
+	row->addWidget(m_view, 1);
+
+	QWidget* panel = new QWidget(root);
+	QVBoxLayout* col = new QVBoxLayout(panel);
+	col->setContentsMargins(0, 0, 0, 0);
+	col->setSpacing(6);
+
+	col->addWidget(new QLabel("Selected color (2-bit per channel):", panel));
+
+	col->addWidget(new QLabel("A", panel));
+	m_a = _make2BitSlider(panel, "pblvA");
+	col->addWidget(m_a);
+
+	col->addWidget(new QLabel("R", panel));
+	m_r = _make2BitSlider(panel, "pblvR");
+	col->addWidget(m_r);
+
+	col->addWidget(new QLabel("G", panel));
+	m_g = _make2BitSlider(panel, "pblvG");
+	col->addWidget(m_g);
+
+	col->addWidget(new QLabel("B", panel));
+	m_b = _make2BitSlider(panel, "pblvB");
+	col->addWidget(m_b);
+
+	m_info = new QLabel(panel);
+	m_info->setWordWrap(true);
+	col->addWidget(m_info);
+	col->addStretch(1);
+
+	row->addWidget(panel, 0);
+	setCentralWidget(root);
+
+	connect(m_a, &QSlider::valueChanged, this, &PblvPalettesWindow::_onSliderChanged);
+	connect(m_r, &QSlider::valueChanged, this, &PblvPalettesWindow::_onSliderChanged);
+	connect(m_g, &QSlider::valueChanged, this, &PblvPalettesWindow::_onSliderChanged);
+	connect(m_b, &QSlider::valueChanged, this, &PblvPalettesWindow::_onSliderChanged);
+
+	_setSlidersEnabled(false);
+	_updateInfoLabel();
+}
+
+void PblvPalettesWindow::setDocument(PblvDocument* doc) {
+	m_doc = doc;
+	m_model->setDocument(doc);
+	if (m_view->selectionModel()) {
+		disconnect(m_view->selectionModel(), nullptr, this, nullptr);
+	}
+	if (m_view->selectionModel()) {
+		connect(m_view->selectionModel(), &QItemSelectionModel::currentChanged, this,
+		        &PblvPalettesWindow::_onCurrentChanged);
+	}
+	m_current = QPersistentModelIndex();
+	_setSlidersEnabled(false);
+	_updateInfoLabel();
+}
+
+void PblvPalettesWindow::_onCurrentChanged(const QModelIndex& current, const QModelIndex& previous) {
+	Q_UNUSED(previous);
+	m_current = QPersistentModelIndex(current);
+	_syncSlidersFromCurrent();
+}
+
+void PblvPalettesWindow::_onSliderChanged() {
+	if (m_updatingUi) {
+		return;
+	}
+	if (!m_doc || !m_doc->isLoaded() || !m_current.isValid()) {
+		_updateInfoLabel();
+		return;
+	}
+	const int palRow = m_current.row();
+	const bool isObj = palRow >= 8;
+	const int palId = isObj ? (palRow - 8) : palRow;
+	const int colorId = m_current.column();
+	const quint8 g = _gcolor8FromA2R2G2B2(m_a->value(), m_r->value(), m_g->value(), m_b->value());
+	if (isObj) {
+		(void) m_doc->setObjPaletteEntry(palId, colorId, g);
+	} else {
+		(void) m_doc->setBgPaletteEntry(palId, colorId, g);
+	}
+	_updateInfoLabel();
+}
+
+void PblvPalettesWindow::_setSlidersEnabled(bool enabled) {
+	m_a->setEnabled(enabled);
+	m_r->setEnabled(enabled);
+	m_g->setEnabled(enabled);
+	m_b->setEnabled(enabled);
+}
+
+void PblvPalettesWindow::_syncSlidersFromCurrent() {
+	if (!m_doc || !m_doc->isLoaded() || !m_current.isValid()) {
+		_setSlidersEnabled(false);
+		_updateInfoLabel();
+		return;
+	}
+	const int palRow = m_current.row();
+	const bool isObj = palRow >= 8;
+	const int palId = isObj ? (palRow - 8) : palRow;
+	const int colorId = m_current.column();
+	const QVector<quint8> bytes = isObj ? m_doc->objPaletteBytes() : m_doc->bgPaletteBytes();
+	const int idx = palId * 4 + colorId;
+	if (idx < 0 || idx >= bytes.size()) {
+		_setSlidersEnabled(false);
+		_updateInfoLabel();
+		return;
+	}
+	const quint8 g = bytes[idx];
+
+	m_updatingUi = true;
+	_setSlidersEnabled(true);
+	m_a->setValue(_a2FromGColor8(g));
+	m_r->setValue(_r2FromGColor8(g));
+	m_g->setValue(_g2FromGColor8(g));
+	m_b->setValue(_b2FromGColor8(g));
+	m_updatingUi = false;
+	_updateInfoLabel();
+}
+
+void PblvPalettesWindow::_updateInfoLabel() {
+	if (!m_doc || !m_doc->isLoaded() || !m_current.isValid()) {
+		m_info->setText("Select a palette cell to edit.");
+		return;
+	}
+	const int palRow = m_current.row();
+	const bool isObj = palRow >= 8;
+	const int palId = isObj ? (palRow - 8) : palRow;
+	const int colorId = m_current.column();
+	const quint8 g = _gcolor8FromA2R2G2B2(m_a->value(), m_r->value(), m_g->value(), m_b->value());
+	const int a = _to8(m_a->value());
+	const int r = _to8(m_r->value());
+	const int gg = _to8(m_g->value());
+	const int b = _to8(m_b->value());
+	const QString prefix = isObj ? QString("OBJ") : QString("BG");
+	m_info->setText(QString("%1%2 C%3\nGColor8=0x%4\nARGB8=(%5,%6,%7,%8)")
+	                    .arg(prefix)
+	                    .arg(palId)
+	                    .arg(colorId)
+	                    .arg(g, 2, 16, QLatin1Char('0'))
+	                    .arg(a)
+	                    .arg(r)
+	                    .arg(gg)
+	                    .arg(b)
+	                    .toUpper());
+}
+
+int PblvPalettesWindow::_a2FromGColor8(quint8 g) {
+	return (g >> 6) & 3;
+}
+
+int PblvPalettesWindow::_r2FromGColor8(quint8 g) {
+	return (g >> 4) & 3;
+}
+
+int PblvPalettesWindow::_g2FromGColor8(quint8 g) {
+	return (g >> 2) & 3;
+}
+
+int PblvPalettesWindow::_b2FromGColor8(quint8 g) {
+	return (g >> 0) & 3;
+}
+
+quint8 PblvPalettesWindow::_gcolor8FromA2R2G2B2(int a2, int r2, int g2, int b2) {
+	a2 &= 3;
+	r2 &= 3;
+	g2 &= 3;
+	b2 &= 3;
+	return static_cast<quint8>((a2 << 6) | (r2 << 4) | (g2 << 2) | (b2 << 0));
+}
+
+int PblvPalettesWindow::_to8(int v2) {
+	return (v2 & 3) * 85;
+}
