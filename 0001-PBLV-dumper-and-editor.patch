+
+	PblvDocument* m_doc = nullptr;
+	PblvTileMapWidget* m_view = nullptr;
+	PblvMapWindow* m_mapWindow = nullptr;
+	PblvTilesWindow* m_tilesWindow = nullptr;
+	PblvPalettesWindow* m_palettesWindow = nullptr;
