diff --git a/src/platform/qt/pblv/PblvMapModel.cpp b/src/platform/qt/pblv/PblvMapModel.cpp
new file mode 100644
index 000000000..699e757cf
--- /dev/null
+++ b/src/platform/qt/pblv/PblvMapModel.cpp
@@ -0,0 +1,205 @@
+#include "PblvMapModel.h"
+
+#include "PblvDocument.h"
+
+#include <QtCore/QString>
+
+PblvMapModel::PblvMapModel(QObject* parent)
+    : QAbstractTableModel(parent) { }
+
+void PblvMapModel::setDocument(PblvDocument* doc) {
+	if (m_doc == doc) {
+		return;
+	}
+	beginResetModel();
+	if (m_doc) {
+		disconnect(m_doc, nullptr, this, nullptr);
+	}
+	m_doc = doc;
+	if (m_doc) {
+		connect(m_doc, &PblvDocument::documentChanged, this, &PblvMapModel::_onDocChanged);
+		connect(m_doc, &PblvDocument::documentLoaded, this, &PblvMapModel::_onDocLoaded);
+	}
+	endResetModel();
+}
+
+PblvDocument* PblvMapModel::document() const {
+	return m_doc;
+}
+
+int PblvMapModel::rowCount(const QModelIndex& parent) const {
+	if (parent.isValid() || !m_doc || !m_doc->isLoaded()) {
+		return 0;
+	}
+	return m_doc->mapH();
+}
+
+int PblvMapModel::columnCount(const QModelIndex& parent) const {
+	if (parent.isValid() || !m_doc || !m_doc->isLoaded()) {
+		return 0;
+	}
+	return m_doc->mapW();
+}
+
+QVariant PblvMapModel::data(const QModelIndex& index, int role) const {
+	if (!m_doc || !m_doc->isLoaded() || !index.isValid()) {
+		return {};
+	}
+	const int x = index.column();
+	const int y = index.row();
+	if (x < 0 || y < 0 || x >= m_doc->mapW() || y >= m_doc->mapH()) {
+		return {};
+	}
+	const quint16 tileKey = m_doc->mapTileKey(x, y);
+	const quint8 pal = m_doc->mapPalette(x, y);
+
+	if (role == Qt::DisplayRole || role == Qt::EditRole) {
+		return _formatCellText(tileKey, pal);
+	}
+	if (role == Qt::ToolTipRole) {
+		const quint32 tileId = m_doc->tileIdFromTileKey(tileKey);
+		return QString("tileId=%1, palette=%2").arg(tileId).arg(pal);
+	}
+
+	return {};
+}
+
+bool PblvMapModel::setData(const QModelIndex& index, const QVariant& value, int role) {
+	if (!m_doc || !m_doc->isLoaded() || !index.isValid() || role != Qt::EditRole) {
+		return false;
+	}
+	const int x = index.column();
+	const int y = index.row();
+	if (x < 0 || y < 0 || x >= m_doc->mapW() || y >= m_doc->mapH()) {
+		return false;
+	}
+
+	const QString text = value.toString();
+	quint16 tileKey = 0;
+	bool hasPalette = false;
+	quint8 palette = 0;
+	if (!_parseCellText(text, &tileKey, &hasPalette, &palette)) {
+		return false;
+	}
+	if (!hasPalette) {
+		palette = m_doc->mapPalette(x, y);
+	}
+	m_doc->setMapCell(x, y, tileKey, palette);
+	emit dataChanged(index, index, { Qt::DisplayRole, Qt::EditRole, Qt::ToolTipRole });
+	return true;
+}
+
+Qt::ItemFlags PblvMapModel::flags(const QModelIndex& index) const {
+	if (!index.isValid()) {
+		return Qt::NoItemFlags;
+	}
+	return Qt::ItemIsSelectable | Qt::ItemIsEnabled | Qt::ItemIsEditable;
+}
+
+void PblvMapModel::_onDocChanged() {
+	if (!m_doc || !m_doc->isLoaded()) {
+		return;
+	}
+	const QModelIndex tl = this->index(0, 0);
+	const QModelIndex br = this->index(m_doc->mapH() - 1, m_doc->mapW() - 1);
+	emit dataChanged(tl, br, { Qt::DisplayRole, Qt::EditRole, Qt::ToolTipRole });
+}
+
+void PblvMapModel::_onDocLoaded() {
+	beginResetModel();
+	endResetModel();
+}
+
+QString PblvMapModel::_formatCellText(quint16 tileKey, quint8 palette) const {
+	if (!m_doc || !m_doc->isLoaded()) {
+		return QString("T? P%1").arg(palette & 7);
+	}
+	const quint32 tileId = m_doc->tileIdFromTileKey(tileKey);
+	return QString("T%1 P%2").arg(tileId).arg(palette & 7);
+}
+
+bool PblvMapModel::_parseCellText(const QString& text, quint16* outTileKey, bool* outHasPalette,
+                                  quint8* outPalette) const {
+	if (!m_doc || !m_doc->isLoaded() || !outTileKey || !outHasPalette || !outPalette) {
+		return false;
+	}
+	*outHasPalette = false;
+	*outTileKey = 0;
+	*outPalette = 0;
+
+	QString t = text.trimmed();
+	if (t.isEmpty()) {
+		return false;
+	}
+
+	QString tilePart;
+	QString palPart;
+
+	int sep = t.indexOf(QLatin1Char(':'));
+	if (sep < 0) {
+		sep = t.indexOf(QLatin1Char(','));
+	}
+	if (sep < 0) {
+		sep = t.indexOf(QLatin1Char(' '));
+	}
+
+	if (sep >= 0) {
+		tilePart = t.left(sep).trimmed();
+		palPart = t.mid(sep + 1).trimmed();
+		*outHasPalette = !palPart.isEmpty();
+	} else {
+		tilePart = t;
+		*outHasPalette = false;
+	}
+
+	bool ok = false;
+	quint16 tileKey = 0;
+
+	// Preferred syntax: T<tileId>
+	QString tp = tilePart;
+	if (tp.startsWith('T', Qt::CaseInsensitive)) {
+		tp = tp.mid(1).trimmed();
+	}
+	if (tilePart.startsWith('T', Qt::CaseInsensitive) || tilePart.startsWith('t', Qt::CaseInsensitive)) {
+		const quint32 tileId = tp.toUInt(&ok, 10);
+		if (!ok) {
+			return false;
+		}
+		if (!m_doc->tileKeyFromTileId(tileId, &tileKey)) {
+			return false;
+		}
+	} else {
+		// Legacy syntax: raw tileKey (hex or decimal)
+		quint32 raw = 0;
+		if (tilePart.startsWith("0x", Qt::CaseInsensitive)) {
+			raw = tilePart.toUInt(&ok, 16);
+		} else {
+			raw = tilePart.toUInt(&ok, 10);
+		}
+		if (!ok || raw > 0xFFFFu) {
+			return false;
+		}
+		tileKey = static_cast<quint16>(raw);
+	}
+
+	quint32 pal = 0;
+	if (*outHasPalette) {
+		QString pp = palPart;
+		if (pp.startsWith('P', Qt::CaseInsensitive)) {
+			pp = pp.mid(1).trimmed();
+		}
+		pal = pp.toUInt(&ok, 10);
+		if (!ok) {
+			if (palPart.startsWith("0x", Qt::CaseInsensitive)) {
+				pal = palPart.toUInt(&ok, 16);
+			}
+		}
+		if (!ok || pal > 0xFFu) {
+			return false;
+		}
+	}
+
+	*outTileKey = tileKey;
+	*outPalette = static_cast<quint8>(pal & 7);
+	return true;
+}
