+QVector<int> PblvDocument::previewAnimatedMap() const {
+	return m_previewAnimatedMap;
+}
+
+QVector<int> PblvDocument::previewAnimatedSprites() const {
+	return m_previewAnimatedSprites;
+}
+
+void PblvDocument::setPreviewAnimatedMap(const QVector<int>& mapIndices) {
+	m_previewAnimatedMap = mapIndices;
+	emit documentChanged();
