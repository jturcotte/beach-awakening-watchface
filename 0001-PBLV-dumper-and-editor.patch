+	uint16_t tileKey;
+	uint16_t reserved;
+	uint8_t data[PBLV_TILE_BYTES];
+};
+
+struct _PblvlOamUpdate {
+	uint16_t index;
+	uint16_t reserved;
+	uint8_t data[4];
+};
+
+struct _PblvlMapUpdate {
+	uint16_t mapIndex;
+	uint16_t tileKey;
+	uint8_t palette;
+	uint8_t reserved;
+};
+
+struct _PblvlWriter {
+	struct VFile* vf;
+	bool headerWritten;
+	uint32_t framesOffset;
+	uint32_t nFrames;
+	uint32_t pendingFrameDelta;
+
+	uint8_t lcdc;
+	uint8_t scx;
+	uint8_t scy;
+	bool isCgb;
+
+	uint8_t* vram; // GB_SIZE_VRAM bytes
+	uint16_t palette555[64];
+	uint8_t paletteGColor[32]; // BG palettes only (8*4)
+	uint8_t objPaletteGColor[32]; // OBJ palettes (8*4)
+	uint8_t oam[GB_SIZE_OAM];
+	uint8_t oamPacked[GB_SIZE_OAM];
+
+	uint8_t tilePacked[2][PBLV_TILE_COUNT][PBLV_TILE_BYTES];
+	uint16_t mapTileKey[PBLV_MAP_W * PBLV_MAP_H];
+	uint8_t mapPalette[PBLV_MAP_W * PBLV_MAP_H];
+
+	bool mapDirty;
+	uint8_t tileDirty[2][PBLV_TILE_COUNT];
+	uint8_t oamDirty[GB_VIDEO_MAX_OBJ];
+
+	struct _PblvlPalUpdate* palUpdates;
+	size_t palCount;
+	size_t palCap;
+	struct _PblvlPalUpdate* objPalUpdates;
+	size_t objPalCount;
+	size_t objPalCap;
+	struct _PblvlTileUpdate* tileUpdates;
+	size_t tileCount;
+	size_t tileCap;
+	struct _PblvlMapUpdate* mapUpdates;
+	size_t mapCount;
+	size_t mapCap;
+	struct _PblvlOamUpdate* oamUpdates;
+	size_t oamCount;
+	size_t oamCap;
+
+	enum _PblvlParseState parseState;
+	uint8_t packetBuf[sizeof(struct mVideoLoggerDirtyInfo)];
+	size_t packetHave;
+	struct mVideoLoggerDirtyInfo currentPacket;
+	uint32_t payloadAddr;
+	uint32_t payloadLength;
+	uint32_t payloadHave;
+};
+
+static uint8_t _pblvlColorFrom555(uint16_t bgr555) {
+	uint8_t r5 = bgr555 & 0x1F;
+	uint8_t g5 = (bgr555 >> 5) & 0x1F;
+	uint8_t b5 = (bgr555 >> 10) & 0x1F;
+	uint8_t r2 = (uint8_t) ((r5 * 3 + 15) / 31);
+	uint8_t g2 = (uint8_t) ((g5 * 3 + 15) / 31);
+	uint8_t b2 = (uint8_t) ((b5 * 3 + 15) / 31);
+	return (uint8_t) ((3 << 6) | (r2 << 4) | (g2 << 2) | b2);
+}
+
+static void _pblvlTileToPebble2bpp16x16PixelDoubled(const uint8_t* gbTile16, uint8_t outTile[PBLV_TILE_BYTES]) {
+	// GB tile: 8x8, planar 2bpp, 16 bytes.
+	// Output: 16x16, Pebble-packed 2bpp, 64 bytes.
+	int y;
+	for (y = 0; y < 8; ++y) {
+		uint8_t lo = gbTile16[y * 2];
+		uint8_t hi = gbTile16[y * 2 + 1];
+		uint8_t srcPx[8];
+		int x;
+		for (x = 0; x < 8; ++x) {
+			int bit = 7 - x;
+			srcPx[x] = (uint8_t) ((((hi >> bit) & 1) << 1) | ((lo >> bit) & 1));
+		}
+
+		// Duplicate row vertically (2x)
+		int dy;
+		for (dy = 0; dy < 2; ++dy) {
+			int outY = y * 2 + dy;
+			uint8_t rowPx[16];
+			for (x = 0; x < 8; ++x) {
+				rowPx[x * 2 + 0] = srcPx[x];
+				rowPx[x * 2 + 1] = srcPx[x];
+			}
+
+			// Pack 16 pixels -> 4 bytes
+			int bx;
+			for (bx = 0; bx < 4; ++bx) {
+				uint8_t p0 = rowPx[bx * 4 + 0] & 3;
+				uint8_t p1 = rowPx[bx * 4 + 1] & 3;
+				uint8_t p2 = rowPx[bx * 4 + 2] & 3;
+				uint8_t p3 = rowPx[bx * 4 + 3] & 3;
+				outTile[outY * 4 + bx] = (uint8_t) ((p0 << 6) | (p1 << 4) | (p2 << 2) | p3);
+			}
+		}
+	}
+}
+
+static inline void _pblvlWriteU16(struct VFile* vf, uint16_t v) {
+	uint8_t b[2];
+	STORE_16LE(v, 0, b);
+	vf->write(vf, b, sizeof(b));
+}
+
+static inline void _pblvlWriteU32(struct VFile* vf, uint32_t v) {
+	uint8_t b[4];
+	STORE_32LE(v, 0, b);
+	vf->write(vf, b, sizeof(b));
+}
+
+static void _pblvlVecEnsure(void** ptr, size_t* cap, size_t elemSize, size_t want) {
+	if (*cap >= want) {
+		return;
+	}
+	size_t newCap = *cap ? *cap : 16;
+	while (newCap < want) {
+		newCap <<= 1;
+	}
+	*ptr = realloc(*ptr, newCap * elemSize);
+	*cap = newCap;
+}
+
+static void _pblvlRecomputeVisibleMap(struct _PblvlWriter* w) {
+	uint16_t mapBase = (w->lcdc & 0x08) ? 0x1C00 : 0x1800;
+	bool tileDataUnsigned = !!(w->lcdc & 0x10);
+	int tileX0 = w->scx >> 3;
+	int tileY0 = w->scy >> 3;
+	int y;
+	for (y = 0; y < PBLV_MAP_H; ++y) {
+		int x;
+		for (x = 0; x < PBLV_MAP_W; ++x) {
+			int topX = (tileX0 + x) & 0x1F;
+			int topY = (tileY0 + y) & 0x1F;
+			uint16_t mapIndex = (uint16_t) (topX + topY * 0x20);
+			uint8_t tileByte = w->vram[mapBase + mapIndex];
+			uint8_t attrByte = 0;
+			if (w->isCgb) {
+				attrByte = w->vram[GB_SIZE_VRAM_BANK0 + mapBase + mapIndex];
+			}
+			uint8_t palette = w->isCgb ? (attrByte & 0x07) : 0;
+			uint16_t tileIndex;
+			if (tileDataUnsigned) {
+				tileIndex = tileByte;
+			} else {
+				tileIndex = (uint16_t) (256 + (int8_t) tileByte);
+			}
+			if (tileIndex >= PBLV_TILE_COUNT) {
+				tileIndex %= PBLV_TILE_COUNT;
+			}
+			uint16_t tileKey = tileIndex;
+			if (w->isCgb && (attrByte & 0x08)) {
+				tileKey |= 0x8000;
+			}
+			uint16_t visibleIndex = (uint16_t) (x + y * PBLV_MAP_W);
+			w->mapTileKey[visibleIndex] = tileKey;
+			w->mapPalette[visibleIndex] = palette;
+		}
+	}
+}
+
+static void _pblvlWriteHeaderAndKeyframe(struct _PblvlWriter* w) {
+	if (w->headerWritten) {
+		return;
+	}
+	w->vf->seek(w->vf, 0, SEEK_SET);
+
+	// Fixed 32-byte header
+	w->vf->write(w->vf, _PBLV_MAGIC, 4);
+	_pblvlWriteU16(w->vf, (uint16_t) PBLV_VERSION);
+	_pblvlWriteU16(w->vf, 32);
+	_pblvlWriteU32(w->vf, 32); // keyframeOffset
+	_pblvlWriteU32(w->vf, 0); // framesOffset (patched later)
+	_pblvlWriteU32(w->vf, 0); // nFrames (patched later)
+	_pblvlWriteU16(w->vf, PBLV_MAP_W);
+	_pblvlWriteU16(w->vf, PBLV_MAP_H);
+	uint32_t flags = 0;
+	if (w->isCgb) {
+		flags |= PBLV_FLAG_MODEL_CGB;
+		flags |= PBLV_FLAG_VRAM_2BANK;
+	}
+	_pblvlWriteU32(w->vf, flags);
+	_pblvlWriteU32(w->vf, 0);
+
+	// Keyframe body
+	w->vf->write(w->vf, "KEYF", 4);
+	_pblvlWriteU32(w->vf, 0); // length (unused, reserved)
+	uint8_t params[8] = { 0 };
+	params[0] = w->isCgb ? 1 : 0;
+	params[1] = w->lcdc;
+	params[2] = w->scx;
+	params[3] = w->scy;
+	params[4] = (w->lcdc & 0x08) ? 1 : 0;
+	params[5] = (w->lcdc & 0x10) ? 1 : 0;
+	w->vf->write(w->vf, params, sizeof(params));
+	_pblvlWriteU16(w->vf, PBLV_TILE_COUNT);
+	_pblvlWriteU16(w->vf, w->isCgb ? 2 : 1);
+	_pblvlWriteU16(w->vf, PBLV_MAP_W);
+	_pblvlWriteU16(w->vf, PBLV_MAP_H);
+	_pblvlWriteU16(w->vf, 0);
+	_pblvlWriteU16(w->vf, 0);
+
+	// BG palettes: 8 * 4 entries as GColor8
+	_pblvlWriteU16(w->vf, 32);
+	w->vf->write(w->vf, w->paletteGColor, 32);
+
+	// Tile bitmaps
+	uint16_t banks = w->isCgb ? 2 : 1;
+	int bank;
+	for (bank = 0; bank < banks; ++bank) {
+		w->vf->write(w->vf, w->tilePacked[bank], PBLV_TILE_COUNT * PBLV_TILE_BYTES);
+	}
+
+	// Visible BG map
+	uint32_t i;
+	for (i = 0; i < PBLV_MAP_W * PBLV_MAP_H; ++i) {
+		_pblvlWriteU16(w->vf, w->mapTileKey[i]);
+		w->vf->write(w->vf, &w->mapPalette[i], 1);
+		uint8_t z = 0;
+		w->vf->write(w->vf, &z, 1);
+	}
+
+	// OBJ palettes: 8 * 4 entries as GColor8
+	_pblvlWriteU16(w->vf, 32);
+	w->vf->write(w->vf, w->objPaletteGColor, 32);
+
+	// OAM bytes (sprites)
+	_pblvlWriteU16(w->vf, GB_SIZE_OAM);
+	w->vf->write(w->vf, w->oam, GB_SIZE_OAM);
+
+	w->headerWritten = true;
+}
+
+static void _pblvlMarkVRAMDirty(struct _PblvlWriter* w, uint32_t addr, uint32_t len) {
+	uint32_t end = addr + len;
+	// Tile patterns: 0x0000-0x17FF in each bank
+	uint32_t b;
+	for (b = addr; b < end; ++b) {
+		uint32_t bank = b / GB_SIZE_VRAM_BANK0;
+		uint32_t off = b % GB_SIZE_VRAM_BANK0;
+		if (bank > 1) {
+			continue;
+		}
+		if (off < 0x1800) {
+			uint32_t tileIndex = off / 16;
+			if (tileIndex < PBLV_TILE_COUNT) {
+				w->tileDirty[bank][tileIndex] = 1;
+			}
+		} else {
+			// Map region (tilemap + attr map)
+			w->mapDirty = true;
+		}
+	}
+}
+
+static void _pblvlQueuePaletteUpdate(struct _PblvlWriter* w, uint32_t addr, uint16_t value) {
+	uint8_t palette = (uint8_t) (addr / 4);
+	uint8_t color = (uint8_t) (addr % 4);
+	uint8_t gcolor = _pblvlColorFrom555(value);
+	if (addr < 32) {
+		_pblvlVecEnsure((void**) &w->palUpdates, &w->palCap, sizeof(*w->palUpdates), w->palCount + 1);
+		w->palUpdates[w->palCount++] = (struct _PblvlPalUpdate) { palette, color, gcolor, 0 };
+		w->palette555[addr] = value;
+		w->paletteGColor[addr] = gcolor;
+		return;
+	}
+	addr -= 32;
+	palette = (uint8_t) (addr / 4);
+	color = (uint8_t) (addr % 4);
+	_pblvlVecEnsure((void**) &w->objPalUpdates, &w->objPalCap, sizeof(*w->objPalUpdates), w->objPalCount + 1);
+	w->objPalUpdates[w->objPalCount++] = (struct _PblvlPalUpdate) { palette, color, gcolor, 0 };
+	w->palette555[addr + 32] = value;
+	w->objPaletteGColor[addr] = gcolor;
+}
+
+static void _pblvlFinalizeFrame(struct _PblvlWriter* w) {
+	// Called at DIRTY_FRAME.
+	++w->pendingFrameDelta;
+
+	// Materialize tile updates for dirty tiles
+	uint16_t banks = w->isCgb ? 2 : 1;
+	int bank;
+	for (bank = 0; bank < banks; ++bank) {
+		uint32_t ti;
+		for (ti = 0; ti < PBLV_TILE_COUNT; ++ti) {
+			if (!w->tileDirty[bank][ti]) {
+				continue;
+			}
+			w->tileDirty[bank][ti] = 0;
+			uint32_t base = bank * GB_SIZE_VRAM_BANK0 + ti * 16;
+			uint8_t packed[PBLV_TILE_BYTES];
+			_pblvlTileToPebble2bpp16x16PixelDoubled(&w->vram[base], packed);
+			if (!memcmp(w->tilePacked[bank][ti], packed, sizeof(packed))) {
+				continue;
+			}
+			memcpy(w->tilePacked[bank][ti], packed, sizeof(packed));
+			_pblvlVecEnsure((void**) &w->tileUpdates, &w->tileCap, sizeof(*w->tileUpdates), w->tileCount + 1);
+			uint16_t tileKey = (uint16_t) ti;
+			if (bank) {
+				tileKey |= 0x8000;
+			}
+			w->tileUpdates[w->tileCount++] = (struct _PblvlTileUpdate) { tileKey, 0, { 0 } };
+			memcpy(w->tileUpdates[w->tileCount - 1].data, packed, sizeof(packed));
+		}
+	}
+
+	// Materialize map updates if any map region changed
+	if (w->mapDirty) {
+		w->mapDirty = false;
+		uint16_t oldKeys[PBLV_MAP_W * PBLV_MAP_H];
+		uint8_t oldPals[PBLV_MAP_W * PBLV_MAP_H];
+		memcpy(oldKeys, w->mapTileKey, sizeof(oldKeys));
+		memcpy(oldPals, w->mapPalette, sizeof(oldPals));
+		_pblvlRecomputeVisibleMap(w);
+		uint32_t i;
+		for (i = 0; i < PBLV_MAP_W * PBLV_MAP_H; ++i) {
+			if (oldKeys[i] == w->mapTileKey[i] && oldPals[i] == w->mapPalette[i]) {
+				continue;
+			}
+			_pblvlVecEnsure((void**) &w->mapUpdates, &w->mapCap, sizeof(*w->mapUpdates), w->mapCount + 1);
+			w->mapUpdates[w->mapCount++] =
+			    (struct _PblvlMapUpdate) { (uint16_t) i, w->mapTileKey[i], w->mapPalette[i], 0 };
+		}
+	}
+
+	// Materialize OAM updates (sprites)
+	uint32_t si;
+	for (si = 0; si < GB_VIDEO_MAX_OBJ; ++si) {
+		if (!w->oamDirty[si]) {
+			continue;
+		}
+		w->oamDirty[si] = 0;
+		const uint32_t off = si * 4;
+		if (!memcmp(&w->oamPacked[off], &w->oam[off], 4)) {
+			continue;
+		}
+		_pblvlVecEnsure((void**) &w->oamUpdates, &w->oamCap, sizeof(*w->oamUpdates), w->oamCount + 1);
+		w->oamUpdates[w->oamCount++] = (struct _PblvlOamUpdate) { (uint16_t) si, 0, { 0, 0, 0, 0 } };
+		memcpy(w->oamUpdates[w->oamCount - 1].data, &w->oam[off], 4);
+		memcpy(&w->oamPacked[off], &w->oam[off], 4);
+	}
+
+	if (!w->palCount && !w->tileCount && !w->mapCount && !w->objPalCount && !w->oamCount) {
+		return;
+	}
+
+	if (!w->headerWritten) {
+		_pblvlWriteHeaderAndKeyframe(w);
+	}
+
+	// Patch framesOffset on first emitted frame
+	if (!w->framesOffset) {
+		w->framesOffset = (uint32_t) w->vf->seek(w->vf, 0, SEEK_CUR);
+		w->vf->seek(w->vf, 12, SEEK_SET);
+		_pblvlWriteU32(w->vf, w->framesOffset);
+		w->vf->seek(w->vf, w->framesOffset, SEEK_SET);
+	}
+
+	// Frame header
+	_pblvlWriteU16(w->vf, (uint16_t) w->pendingFrameDelta);
+	_pblvlWriteU16(w->vf, (uint16_t) w->palCount);
+	_pblvlWriteU16(w->vf, (uint16_t) w->tileCount);
+	_pblvlWriteU16(w->vf, (uint16_t) w->mapCount);
+	_pblvlWriteU16(w->vf, (uint16_t) w->objPalCount);
+	_pblvlWriteU16(w->vf, (uint16_t) w->oamCount);
+
+	// Payloads
+	if (w->palCount) {
+		w->vf->write(w->vf, w->palUpdates, w->palCount * sizeof(*w->palUpdates));
+	}
+	if (w->tileCount) {
+		w->vf->write(w->vf, w->tileUpdates, w->tileCount * sizeof(*w->tileUpdates));
+	}
+	if (w->mapCount) {
+		w->vf->write(w->vf, w->mapUpdates, w->mapCount * sizeof(*w->mapUpdates));
+	}
+	if (w->objPalCount) {
+		w->vf->write(w->vf, w->objPalUpdates, w->objPalCount * sizeof(*w->objPalUpdates));
+	}
+	if (w->oamCount) {
+		w->vf->write(w->vf, w->oamUpdates, w->oamCount * sizeof(*w->oamUpdates));
+	}
+
+	++w->nFrames;
+	w->pendingFrameDelta = 0;
+	w->palCount = 0;
+	w->tileCount = 0;
+	w->mapCount = 0;
+	w->objPalCount = 0;
+	w->oamCount = 0;
+}
+
+static void _pblvlConsume(struct _PblvlWriter* w, const uint8_t* data, size_t length) {
+	while (length) {
+		if (w->parseState == PBLVL_NEED_PACKET) {
+			size_t need = sizeof(struct mVideoLoggerDirtyInfo) - w->packetHave;
+			size_t take = need;
+			if (take > length) {
+				take = length;
+			}
+			memcpy(&w->packetBuf[w->packetHave], data, take);
+			w->packetHave += take;
+			data += take;
+			length -= take;
+			if (w->packetHave != sizeof(struct mVideoLoggerDirtyInfo)) {
+				continue;
+			}
+			struct mVideoLoggerDirtyInfo raw;
+			memcpy(&raw, w->packetBuf, sizeof(raw));
+			LOAD_32LE(w->currentPacket.type, 0, &raw.type);
+			LOAD_32LE(w->currentPacket.address, 0, &raw.address);
+			LOAD_32LE(w->currentPacket.value, 0, &raw.value);
+			LOAD_32LE(w->currentPacket.value2, 0, &raw.value2);
+			w->packetHave = 0;
+			switch (w->currentPacket.type) {
+			case DIRTY_VRAM:
+				w->payloadAddr = w->currentPacket.address;
+				w->payloadLength = w->currentPacket.value;
+				w->payloadHave = 0;
+				w->parseState = PBLVL_NEED_PAYLOAD;
+				break;
+			case DIRTY_PALETTE:
+				_pblvlQueuePaletteUpdate(w, w->currentPacket.address, (uint16_t) w->currentPacket.value);
+				break;
+			case DIRTY_OAM:
+				if (w->currentPacket.address < GB_SIZE_OAM) {
+					uint32_t addr = w->currentPacket.address;
+					w->oam[addr] = (uint8_t) w->currentPacket.value;
+					uint32_t spriteIndex = addr / 4;
+					if (spriteIndex < GB_VIDEO_MAX_OBJ) {
+						w->oamDirty[spriteIndex] = 1;
+					}
+				}
+				break;
+			case DIRTY_REGISTER:
+				// We intentionally ignore register changes after start; the export assumes a static view.
+				break;
+			case DIRTY_FRAME:
+				_pblvlFinalizeFrame(w);
+				break;
+			default:
+				// Ignore scanlines/ranges/flush/OAM/buffers for now.
+				break;
+			}
+			continue;
+		}
+
+		// NEED_PAYLOAD: currently only VRAM blocks
+		size_t remaining = w->payloadLength - w->payloadHave;
+		size_t take = remaining;
+		if (take > length) {
+			take = length;
+		}
+		if (w->payloadAddr + w->payloadHave + take <= GB_SIZE_VRAM) {
+			memcpy(&w->vram[w->payloadAddr + w->payloadHave], data, take);
+		}
+		w->payloadHave += take;
+		data += take;
+		length -= take;
+		if (w->payloadHave == w->payloadLength) {
+			_pblvlMarkVRAMDirty(w, w->payloadAddr, w->payloadLength);
+			w->parseState = PBLVL_NEED_PACKET;
+		}
+	}
+}
+
+static void _pblvlInitFromCore(struct _PblvlWriter* w, struct mCore* core) {
+	struct GB* gb = (struct GB*) core->board;
+	w->isCgb = gb->model >= GB_MODEL_CGB;
+	w->lcdc = gb->memory.io[GB_REG_LCDC];
+	w->scx = gb->memory.io[GB_REG_SCX];
+	w->scy = gb->memory.io[GB_REG_SCY];
+
+	memcpy(w->vram, gb->video.vram, GB_SIZE_VRAM);
+	memcpy(w->palette555, gb->video.palette, sizeof(w->palette555));
+	uint32_t i;
+	for (i = 0; i < 32; ++i) {
+		w->paletteGColor[i] = _pblvlColorFrom555(w->palette555[i]);
+	}
+	for (i = 0; i < 32; ++i) {
+		w->objPaletteGColor[i] = _pblvlColorFrom555(w->palette555[32 + i]);
+	}
+	memcpy(w->oam, gb->video.oam.obj, GB_SIZE_OAM);
+	memcpy(w->oamPacked, w->oam, GB_SIZE_OAM);
+
+	uint16_t banks = w->isCgb ? 2 : 1;
+	int bank;
+	for (bank = 0; bank < banks; ++bank) {
+		uint32_t ti;
+		for (ti = 0; ti < PBLV_TILE_COUNT; ++ti) {
+			uint32_t base = bank * GB_SIZE_VRAM_BANK0 + ti * 16;
+			_pblvlTileToPebble2bpp16x16PixelDoubled(&w->vram[base], w->tilePacked[bank][ti]);
+		}
+	}
+
+	_pblvlRecomputeVisibleMap(w);
+	memset(w->tileDirty, 0, sizeof(w->tileDirty));
+	w->mapDirty = false;
+	memset(w->oamDirty, 0, sizeof(w->oamDirty));
+	w->palCount = w->tileCount = w->mapCount = 0;
+	w->objPalCount = w->oamCount = 0;
+	w->pendingFrameDelta = 0;
+	w->parseState = PBLVL_NEED_PACKET;
+	w->packetHave = 0;
+}
+
+static void _pblvlEnable(struct mVideoLogContext* context) {
+	if (context->pebbleExport || !context->write || !context->core || !context->backing) {
+		return;
+	}
+	if (context->core->platform(context->core) != mPLATFORM_GB) {
+		return;
+	}
+	struct _PblvlWriter* w = calloc(1, sizeof(*w));
+	w->vf = context->backing;
+	w->vram = malloc(GB_SIZE_VRAM);
+	context->pebbleExport = true;
+	context->pebbleState = w;
+	_pblvlInitFromCore(w, context->core);
+	// Clear any pre-output buffered packets; the export keyframe anchors here.
+	size_t i;
+	for (i = 0; i < context->nChannels; ++i) {
+		CircleBufferClear(&context->channels[i].buffer);
+		CircleBufferClear(&context->channels[i].injectedBuffer);
+	}
+	context->backing->truncate(context->backing, 0);
+	context->backing->seek(context->backing, 0, SEEK_SET);
+}
+
+static void _pblvlDisableAndFinalize(struct mVideoLogContext* context) {
+	if (!context->pebbleExport || !context->pebbleState) {
+		return;
+	}
+	struct _PblvlWriter* w = context->pebbleState;
+	if (!w->headerWritten) {
+		_pblvlWriteHeaderAndKeyframe(w);
+	}
+	// Patch frame count
+	w->vf->seek(w->vf, 16, SEEK_SET);
+	_pblvlWriteU32(w->vf, w->nFrames);
+	w->vf->seek(w->vf, 0, SEEK_END);
+
+	free(w->palUpdates);
+	free(w->objPalUpdates);
+	free(w->tileUpdates);
+	free(w->mapUpdates);
+	free(w->oamUpdates);
+	free(w->vram);
+	free(w);
+	context->pebbleState = NULL;
+	context->pebbleExport = false;
+}
 
