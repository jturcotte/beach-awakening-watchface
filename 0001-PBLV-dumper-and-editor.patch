diff --git a/src/platform/qt/pblv/PblvMapWindow.cpp b/src/platform/qt/pblv/PblvMapWindow.cpp
new file mode 100644
index 000000000..ba320b200
--- /dev/null
+++ b/src/platform/qt/pblv/PblvMapWindow.cpp
@@ -0,0 +1,234 @@
+#include "PblvMapWindow.h"
+
+#include "PblvMapModel.h"
+
+#include <QtGui/QClipboard>
+#include <QtGui/QGuiApplication>
+#include <QtGui/QKeySequence>
+
+#include <QtWidgets/QAction>
+#include <QtWidgets/QHeaderView>
+#include <QtWidgets/QLineEdit>
+#include <QtWidgets/QStyledItemDelegate>
+#include <QtWidgets/QTableView>
+
+#include <QtCore/QItemSelectionModel>
+#include <QtCore/QRect>
+#include <QtCore/QRegExp>
+#include <QtCore/QSet>
+#include <QtCore/QStringList>
+
+namespace {
+class PblvMultiEditDelegate : public QStyledItemDelegate {
+public:
+	explicit PblvMultiEditDelegate(QTableView* view)
+	    : QStyledItemDelegate(view)
+	    , m_view(view) { }
+
+	QWidget* createEditor(QWidget* parent, const QStyleOptionViewItem& option,
+	                      const QModelIndex& index) const override {
+		Q_UNUSED(option);
+		Q_UNUSED(index);
+		auto* e = new QLineEdit(parent);
+		e->setFrame(false);
+		return e;
+	}
+
+	void setEditorData(QWidget* editor, const QModelIndex& index) const override {
+		auto* e = qobject_cast<QLineEdit*>(editor);
+		if (!e) {
+			return;
+		}
+		e->setText(index.data(Qt::EditRole).toString());
+	}
+
+	void setModelData(QWidget* editor, QAbstractItemModel* model, const QModelIndex& index) const override {
+		auto* e = qobject_cast<QLineEdit*>(editor);
+		if (!e || !m_view || !m_view->selectionModel()) {
+			QStyledItemDelegate::setModelData(editor, model, index);
+			return;
+		}
+		const QString text = e->text();
+		const QModelIndexList selected = m_view->selectionModel()->selectedIndexes();
+		if (selected.isEmpty()) {
+			model->setData(index, text, Qt::EditRole);
+			return;
+		}
+		for (const QModelIndex& idx : selected) {
+			model->setData(idx, text, Qt::EditRole);
+		}
+	}
+
+private:
+	QTableView* m_view = nullptr;
+};
+} // namespace
+
+PblvMapWindow::PblvMapWindow(QWidget* parent)
+    : QMainWindow(parent) {
+	setWindowTitle("PBLV Map");
+
+	m_view = new QTableView(this);
+	m_model = new PblvMapModel(this);
+	m_delegate = new PblvMultiEditDelegate(m_view);
+
+	m_view->setModel(m_model);
+	m_view->setItemDelegate(m_delegate);
+	m_view->setSelectionMode(QAbstractItemView::ExtendedSelection);
+	m_view->setSelectionBehavior(QAbstractItemView::SelectItems);
+	m_view->setEditTriggers(QAbstractItemView::DoubleClicked | QAbstractItemView::EditKeyPressed |
+	                        QAbstractItemView::AnyKeyPressed);
+	m_view->horizontalHeader()->setSectionResizeMode(QHeaderView::ResizeToContents);
+	m_view->verticalHeader()->setSectionResizeMode(QHeaderView::ResizeToContents);
+
+	auto* copyAction = new QAction(this);
+	copyAction->setShortcut(QKeySequence::Copy);
+	copyAction->setShortcutContext(Qt::WidgetWithChildrenShortcut);
+	addAction(copyAction);
+	connect(copyAction, &QAction::triggered, this, &PblvMapWindow::_copySelection);
+
+	auto* pasteAction = new QAction(this);
+	pasteAction->setShortcut(QKeySequence::Paste);
+	pasteAction->setShortcutContext(Qt::WidgetWithChildrenShortcut);
+	addAction(pasteAction);
+	connect(pasteAction, &QAction::triggered, this, &PblvMapWindow::_pasteSelection);
+
+	setCentralWidget(m_view);
+
+	if (m_view->selectionModel()) {
+		connect(m_view->selectionModel(), &QItemSelectionModel::selectionChanged, this,
+		        [this](const QItemSelection&, const QItemSelection&) {
+			        const QModelIndexList selected = m_view->selectionModel()->selectedIndexes();
+			        QVector<QPoint> cells;
+			        cells.reserve(selected.size());
+			        QSet<quint32> seen;
+			        for (const QModelIndex& idx : selected) {
+				        if (!idx.isValid()) {
+					        continue;
+				        }
+				        const quint32 key =
+				            (static_cast<quint32>(idx.row()) << 16) | static_cast<quint32>(idx.column());
+				        if (seen.contains(key)) {
+					        continue;
+				        }
+				        seen.insert(key);
+				        cells.append(QPoint(idx.column(), idx.row()));
+			        }
+			        emit selectedCellsChanged(cells);
+		        });
+
+		connect(m_view->selectionModel(), &QItemSelectionModel::currentChanged, this,
+		        [this](const QModelIndex& current, const QModelIndex&) {
+			        if (!current.isValid()) {
+				        return;
+			        }
+			        emit selectedCellChanged(current.column(), current.row());
+		        });
+	}
+}
+
+void PblvMapWindow::setDocument(PblvDocument* doc) {
+	m_model->setDocument(doc);
+}
+
+PblvMapModel* PblvMapWindow::model() const {
+	return m_model;
+}
+
+QRect PblvMapWindow::_selectionBounds() const {
+	if (!m_view || !m_view->selectionModel()) {
+		return {};
+	}
+	const QModelIndexList selected = m_view->selectionModel()->selectedIndexes();
+	if (selected.isEmpty()) {
+		return {};
+	}
+	int minRow = selected.first().row();
+	int maxRow = minRow;
+	int minCol = selected.first().column();
+	int maxCol = minCol;
+	for (const QModelIndex& idx : selected) {
+		if (!idx.isValid()) {
+			continue;
+		}
+		minRow = qMin(minRow, idx.row());
+		maxRow = qMax(maxRow, idx.row());
+		minCol = qMin(minCol, idx.column());
+		maxCol = qMax(maxCol, idx.column());
+	}
+	return QRect(minCol, minRow, (maxCol - minCol) + 1, (maxRow - minRow) + 1);
+}
+
+void PblvMapWindow::_copySelection() {
+	if (!m_model || !m_view || !m_view->selectionModel()) {
+		return;
+	}
+	const QRect bounds = _selectionBounds();
+	if (!bounds.isValid()) {
+		return;
+	}
+	QStringList lines;
+	lines.reserve(bounds.height());
+	for (int y = bounds.top(); y <= bounds.bottom(); ++y) {
+		QStringList cols;
+		cols.reserve(bounds.width());
+		for (int x = bounds.left(); x <= bounds.right(); ++x) {
+			const QModelIndex idx = m_model->index(y, x);
+			cols.append(m_model->data(idx, Qt::EditRole).toString());
+		}
+		lines.append(cols.join(QLatin1Char('\t')));
+	}
+	QClipboard* cb = QGuiApplication::clipboard();
+	if (cb) {
+		cb->setText(lines.join(QLatin1Char('\n')));
+	}
+}
+
+void PblvMapWindow::_pasteSelection() {
+	if (!m_model || !m_view) {
+		return;
+	}
+	QClipboard* cb = QGuiApplication::clipboard();
+	if (!cb) {
+		return;
+	}
+	const QString text = cb->text();
+	if (text.trimmed().isEmpty()) {
+		return;
+	}
+
+	QModelIndex anchor = m_view->currentIndex();
+	if (!anchor.isValid()) {
+		const QRect bounds = _selectionBounds();
+		if (bounds.isValid()) {
+			anchor = m_model->index(bounds.top(), bounds.left());
+		}
+	}
+	if (!anchor.isValid()) {
+		return;
+	}
+
+	const QStringList rows = text.split(QRegExp("\\r?\\n"), Qt::SkipEmptyParts);
+	if (rows.isEmpty()) {
+		return;
+	}
+	const int startRow = anchor.row();
+	const int startCol = anchor.column();
+
+	for (int r = 0; r < rows.size(); ++r) {
+		const QStringList cols = rows[r].split(QLatin1Char('\t'));
+		for (int c = 0; c < cols.size(); ++c) {
+			const int row = startRow + r;
+			const int col = startCol + c;
+			const QModelIndex idx = m_model->index(row, col);
+			if (!idx.isValid()) {
+				continue;
+			}
+			const QString cell = cols[c].trimmed();
+			if (cell.isEmpty()) {
+				continue;
+			}
+			m_model->setData(idx, cell, Qt::EditRole);
+		}
+	}
+}
