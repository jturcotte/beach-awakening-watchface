+#pragma once
+
+#include <QtCore/QAbstractTableModel>
+
+class PblvDocument;
+
+class PblvTilesModel : public QAbstractTableModel {
+	Q_OBJECT
+
+public:
+	explicit PblvTilesModel(QObject* parent = nullptr);
+
+	void setDocument(PblvDocument* doc);
+	PblvDocument* document() const;
+
+	int rowCount(const QModelIndex& parent = QModelIndex()) const override;
+	int columnCount(const QModelIndex& parent = QModelIndex()) const override;
+	QVariant data(const QModelIndex& index, int role) const override;
+	QVariant headerData(int section, Qt::Orientation orientation, int role) const override;
+
+	int tilesPerRow() const;
+
+private slots:
+	void _onDocChanged();
+	void _onDocLoaded();
+
+private:
+	static QImage _tileToImage(const quint8* tilePixels, int tileW, int tileH, const QVector<quint8>& bgPaletteBytes,
+	                           quint8 paletteId);
+
+	PblvDocument* m_doc = nullptr;
+	int m_tilesPerRow = 16;
+	int m_tileScale = 2;
+};
diff --git a/src/platform/qt/pblv/PblvTilesWindow.cpp b/src/platform/qt/pblv/PblvTilesWindow.cpp
new file mode 100644
index 000000000..6b17cd6bf
--- /dev/null
+++ b/src/platform/qt/pblv/PblvTilesWindow.cpp
@@ -0,0 +1,282 @@
+#include "PblvTilesWindow.h"
+
+#include "PblvDocument.h"
+#include "PblvTilesModel.h"
+
+#include <QtGui/QKeyEvent>
+#include <QtGui/QMouseEvent>
+#include <QtGui/QPainter>
+#include <QtWidgets/QHBoxLayout>
+#include <QtWidgets/QHeaderView>
+#include <QtWidgets/QLabel>
+#include <QtWidgets/QTableView>
+#include <QtWidgets/QVBoxLayout>
+#include <QtWidgets/QWidget>
+
+namespace {
+QRgb _colorFromGColor8(quint8 g) {
+	const int a2 = (g >> 6) & 3;
+	const int r2 = (g >> 4) & 3;
+	const int g2 = (g >> 2) & 3;
+	const int b2 = (g >> 0) & 3;
+	return qRgba(r2 * 85, g2 * 85, b2 * 85, a2 * 85);
+}
+
+class PblvTileEditorWidget final : public QWidget {
+public:
+	explicit PblvTileEditorWidget(QWidget* parent = nullptr)
+	    : QWidget(parent) {
+		setMinimumSize(QSize(256, 256));
+		setSizePolicy(QSizePolicy::Fixed, QSizePolicy::Fixed);
+		setFocusPolicy(Qt::StrongFocus);
+	}
+
+	void setDocument(PblvDocument* doc) {
+		if (m_doc == doc) {
+			return;
+		}
+		if (m_doc) {
+			disconnect(m_doc, nullptr, this, nullptr);
+		}
+		m_doc = doc;
+		if (m_doc) {
+			connect(m_doc, &PblvDocument::documentChanged, this, QOverload<>::of(&QWidget::update));
+			connect(m_doc, &PblvDocument::documentLoaded, this, QOverload<>::of(&QWidget::update));
+		}
+		update();
+	}
+
+	void setTile(quint16 bank, quint16 tileIndex) {
+		m_hasTile = true;
+		m_bank = bank;
+		m_tileIndex = tileIndex;
+		m_selection = QRect(0, 0, 1, 1);
+		m_dragging = false;
+		update();
+	}
+
+	void clearTile() {
+		m_hasTile = false;
+		m_selection = QRect();
+		m_dragging = false;
+		update();
+	}
+
+	QSize sizeHint() const override { return QSize(256, 256); }
+
+protected:
+	void paintEvent(QPaintEvent* event) override {
+		Q_UNUSED(event);
+		QPainter p(this);
+		p.fillRect(rect(), palette().window());
+		p.setRenderHint(QPainter::Antialiasing, false);
+
+		if (!m_doc || !m_doc->isLoaded() || !m_hasTile) {
+			p.setPen(palette().text().color());
+			p.drawText(rect().adjusted(6, 6, -6, -6), Qt::AlignLeft | Qt::AlignTop, "Click a tile to edit");
+			return;
+		}
+
+		const int tileW = m_doc->tileW();
+		const int tileH = m_doc->tileH();
+		const int bytesPerRow = tileW / 4;
+		const int cell = qMax(1, qMin(width() / tileW, height() / tileH));
+		const int gridW = tileW * cell;
+		const int gridH = tileH * cell;
+		const QRect gridRect((width() - gridW) / 2, (height() - gridH) / 2, gridW, gridH);
+
+		const QVector<quint8> pal = m_doc->bgPaletteBytes();
+		auto colorAt = [&](quint8 colorId) -> QRgb {
+			const int idx = (0 * 4) + (colorId & 3);
+			if (idx < 0 || idx >= pal.size()) {
+				return qRgba(0, 0, 0, 255);
+			}
+			return _colorFromGColor8(pal[idx]);
+		};
+
+		const quint8* tile = nullptr;
+		if (!m_doc->tilePixels(m_bank, m_tileIndex, &tile) || !tile) {
+			p.setPen(palette().text().color());
+			p.drawText(rect().adjusted(6, 6, -6, -6), Qt::AlignLeft | Qt::AlignTop, "Invalid tile");
+			return;
+		}
+
+		for (int y = 0; y < tileH; ++y) {
+			for (int x = 0; x < tileW; ++x) {
+				const quint8 b = tile[y * bytesPerRow + (x / 4)];
+				const int shift = 6 - 2 * (x & 3);
+				const quint8 px = static_cast<quint8>((b >> shift) & 3);
+				p.fillRect(QRect(gridRect.x() + x * cell, gridRect.y() + y * cell, cell, cell),
+				           QColor::fromRgba(colorAt(px)));
+			}
+		}
+
+		// Grid lines
+		QPen pen(palette().mid().color());
+		pen.setCosmetic(true);
+		p.setPen(pen);
+		for (int x = 0; x <= tileW; ++x) {
+			p.drawLine(gridRect.x() + x * cell, gridRect.y(), gridRect.x() + x * cell, gridRect.bottom());
+		}
+		for (int y = 0; y <= tileH; ++y) {
+			p.drawLine(gridRect.x(), gridRect.y() + y * cell, gridRect.right(), gridRect.y() + y * cell);
+		}
+
+		// Selection overlay
+		if (m_selection.isValid()) {
+			QRect s = m_selection.normalized().intersected(QRect(0, 0, tileW, tileH));
+			if (s.isValid()) {
+				QPen selPen(Qt::red);
+				selPen.setCosmetic(true);
+				selPen.setWidth(2);
+				p.setPen(selPen);
+				p.setBrush(Qt::NoBrush);
+				const QRect selRect(gridRect.x() + s.left() * cell, gridRect.y() + s.top() * cell, s.width() * cell,
+				                    s.height() * cell);
+				p.drawRect(selRect.adjusted(1, 1, -2, -2));
+			}
+		}
+	}
+
+	void mousePressEvent(QMouseEvent* event) override {
+		if (!m_doc || !m_doc->isLoaded() || !m_hasTile) {
+			return;
+		}
+		if (event->button() != Qt::LeftButton) {
+			return;
+		}
+		setFocus(Qt::MouseFocusReason);
+		const int tileW = m_doc->tileW();
+		const int tileH = m_doc->tileH();
+		const int cell = qMax(1, qMin(width() / tileW, height() / tileH));
+		const int gridW = tileW * cell;
+		const int gridH = tileH * cell;
+		const QRect gridRect((width() - gridW) / 2, (height() - gridH) / 2, gridW, gridH);
+		if (!gridRect.contains(event->pos())) {
+			return;
+		}
+		const int x = (event->pos().x() - gridRect.x()) / cell;
+		const int y = (event->pos().y() - gridRect.y()) / cell;
+		if (x < 0 || y < 0 || x >= tileW || y >= tileH) {
+			return;
+		}
+		m_dragging = true;
+		m_anchor = QPoint(x, y);
+		m_selection = QRect(m_anchor, m_anchor);
+		update();
+	}
+
+	void mouseMoveEvent(QMouseEvent* event) override {
+		if (!m_dragging || !m_doc || !m_doc->isLoaded() || !m_hasTile) {
+			return;
+		}
+		const int tileW = m_doc->tileW();
+		const int tileH = m_doc->tileH();
+		const int cell = qMax(1, qMin(width() / tileW, height() / tileH));
+		const int gridW = tileW * cell;
+		const int gridH = tileH * cell;
+		const QRect gridRect((width() - gridW) / 2, (height() - gridH) / 2, gridW, gridH);
+		QPoint pos = event->pos();
+		pos.setX(qBound(gridRect.left(), pos.x(), gridRect.right() - 1));
+		pos.setY(qBound(gridRect.top(), pos.y(), gridRect.bottom() - 1));
+		const int x = (pos.x() - gridRect.x()) / cell;
+		const int y = (pos.y() - gridRect.y()) / cell;
+		m_selection = QRect(m_anchor, QPoint(x, y));
+		update();
+	}
+
+	void mouseReleaseEvent(QMouseEvent* event) override {
+		Q_UNUSED(event);
+		m_dragging = false;
+	}
+
+	void keyPressEvent(QKeyEvent* event) override {
+		if (!m_doc || !m_doc->isLoaded() || !m_hasTile || !m_selection.isValid()) {
+			QWidget::keyPressEvent(event);
+			return;
+		}
+		if (event->key() == Qt::Key_Right) {
+			(void) m_doc->cycleTilePixels(m_bank, m_tileIndex, m_selection, +1);
+			event->accept();
+			return;
+		}
+		if (event->key() == Qt::Key_Left) {
+			(void) m_doc->cycleTilePixels(m_bank, m_tileIndex, m_selection, -1);
+			event->accept();
+			return;
+		}
+		QWidget::keyPressEvent(event);
+	}
+
+private:
+	PblvDocument* m_doc = nullptr;
+	bool m_hasTile = false;
+	quint16 m_bank = 0;
+	quint16 m_tileIndex = 0;
+	bool m_dragging = false;
+	QPoint m_anchor;
+	QRect m_selection;
+};
+} // namespace
+
+PblvTilesWindow::PblvTilesWindow(QWidget* parent)
+    : QMainWindow(parent) {
+	setWindowTitle("PBLV Tiles");
+
+	QWidget* root = new QWidget(this);
+	QHBoxLayout* layout = new QHBoxLayout(root);
+	layout->setContentsMargins(8, 8, 8, 8);
+	layout->setSpacing(8);
+
+	m_view = new QTableView(root);
+	m_model = new PblvTilesModel(this);
+	m_view->setModel(m_model);
+	m_view->setSelectionMode(QAbstractItemView::ExtendedSelection);
+	m_view->setSelectionBehavior(QAbstractItemView::SelectItems);
+	m_view->setEditTriggers(QAbstractItemView::NoEditTriggers);
+	m_view->setIconSize(QSize(16, 16));
+	m_view->horizontalHeader()->setSectionResizeMode(QHeaderView::ResizeToContents);
+	m_view->verticalHeader()->setSectionResizeMode(QHeaderView::ResizeToContents);
+	layout->addWidget(m_view, 1);
+
+	QWidget* panel = new QWidget(root);
+	QVBoxLayout* col = new QVBoxLayout(panel);
+	col->setContentsMargins(0, 0, 0, 0);
+	col->setSpacing(6);
+	col->addWidget(new QLabel("Tile editor: drag to select; Left/Right arrows cycle colors", panel));
+	PblvTileEditorWidget* editor = new PblvTileEditorWidget(panel);
+	m_editor = editor;
+	col->addWidget(editor);
+	col->addStretch(1);
+
+	layout->addWidget(panel, 0);
+	setCentralWidget(root);
+
+	connect(m_view, &QTableView::clicked, this, [this, editor](const QModelIndex& index) {
+		if (!m_doc || !m_doc->isLoaded() || !index.isValid()) {
+			editor->clearTile();
+			return;
+		}
+		const int col = index.column();
+		const int row = index.row();
+		const int rowsPerBank = (m_doc->tileCount() + m_model->tilesPerRow() - 1) / m_model->tilesPerRow();
+		const int bank = row / rowsPerBank;
+		const int rowInBank = row % rowsPerBank;
+		const int tileIndex = rowInBank * m_model->tilesPerRow() + col;
+		if (bank < 0 || bank >= m_doc->bankCount() || tileIndex < 0 || tileIndex >= m_doc->tileCount()) {
+			editor->clearTile();
+			return;
+		}
+		editor->setTile(static_cast<quint16>(bank), static_cast<quint16>(tileIndex));
+	});
+}
+
+void PblvTilesWindow::setDocument(PblvDocument* doc) {
+	m_doc = doc;
+	m_model->setDocument(doc);
+	auto* editor = static_cast<PblvTileEditorWidget*>(m_editor);
+	if (editor) {
+		editor->setDocument(doc);
+		editor->clearTile();
+	}
+}
