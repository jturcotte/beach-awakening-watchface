+// --- Pebble export (GB-only) -------------------------------------------------
+
+// On-disk format magic for the Pebble-focused export.
+static const char _PBLV_MAGIC[] = "PBLV";
+
+enum {
+	PBLV_VERSION = 1,
+};
+
+enum {
+	PBLV_FLAG_MODEL_CGB = 1 << 0,
+	PBLV_FLAG_VRAM_2BANK = 1 << 1,
+};
+
+enum {
+	PBLV_MAP_W = 20,
+	PBLV_MAP_H = 18,
+	PBLV_TILE_COUNT = 384,
+	PBLV_TILE_W = 16,
+	PBLV_TILE_H = 16,
+	PBLV_TILE_BYTES = (PBLV_TILE_W * PBLV_TILE_H) / 4,
+};
+
+enum _PblvlParseState {
+	PBLVL_NEED_PACKET = 0,
+	PBLVL_NEED_PAYLOAD,
+};
+
+struct _PblvlPalUpdate {
+	uint8_t palette;
+	uint8_t color;
+	uint8_t gcolor;
+	uint8_t reserved;
+};
+
