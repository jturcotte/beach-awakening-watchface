@@ -0,0 +1,39 @@
+#pragma once
+
+#include <QtWidgets/QMainWindow>
+
+class PblvDocument;
+class PblvTileMapWidget;
+class PblvMapWindow;
+class PblvTilesWindow;
+class PblvPalettesWindow;
+class PblvSpritesWindow;
+class PblvFramesWindow;
+class QLabel;
+
+class PblvMainWindow : public QMainWindow {
+	Q_OBJECT
+
+public:
+	explicit PblvMainWindow(QWidget* parent = nullptr);
+	bool openPath(const QString& path);
+
+private slots:
+	void openFile();
+	void saveFile();
+	void onSelectedCellChanged(int x, int y);
+
+private:
+	void _setLoadedPath(const QString& path);
